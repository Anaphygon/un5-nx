+		if (m_un5.pending && m_un5.last_at + 2 == m_un5.vertex.size())
+		{
+			prev[0] = m_un5.last_at;
+			prev[1] = m_un5.last_at + 1;
+		}
+		else
+		{
+			const u32 slot = static_cast<u32>(m_un5.consts.size() / UN5_CONSTS_PER_BATCH);
+			m_un5.consts.insert(m_un5.consts.end(), std::begin(m_un5.last_consts), std::end(m_un5.last_consts));
+			m_un5_stats.rechained++;
+			for (u32 j = 0; j < 2; j++)
