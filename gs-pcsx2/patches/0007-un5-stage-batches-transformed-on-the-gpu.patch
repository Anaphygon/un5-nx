+// un5-nx: a batch of UN5's stage program (VU1 program DC7A318002C3DD86),
+// sent untransformed by un5-nx's stand-in for it (ports/un5/vu1_native.cpp,
+// which documents the packet): a GIF tag of NOP registers, then the batch's
+// vertex count and uv z, the strip's own GIF tag, the program's constants
+// (matrix, guard band, fog, near plane and alpha scale) and a qword per
+// vertex (int16 x, y | z, strip flag | RGBA | u, v). The vertex shader
+// (VS_UN5) does what the program did: clip = M (x, y, z, 1) / 4096, GS
+// position 16 xyz / w, ST = uv / 4096 over Q = uv z, fog clamp(z + w * clip w),
+// alpha times the scale. A vertex ends a triangle when its strip flag is 0;
+// the GPU clips at the near plane where the program ran its clipper.
+// Unlike the program, triangles reaching past the guard band are drawn
+// (clipped to the screen) rather than dropped.
+static constexpr u32 UN5_CONSTS_PER_BATCH = 8;
+static constexpr u32 UN5_MAX_CONSTS = 1024; // the VS_UN5 uniform block
+
+void GSState::UN5NativeBatch(const u8* packet)
+{
+	u32 info[4];
+	memcpy(info, packet + 16, sizeof(info));
+	const u32 count = info[2];
+	u64 tag;
+	memcpy(&tag, packet + 32, sizeof(tag));
+	if ((tag >> 46) & 1)
+		ApplyPRIM(static_cast<u32>(tag >> 47) & 0x7FF);
+
+	// As a vertex kick would: draw what is pending under another state, and
+	// what is pending that is not native batches, or has no room left.
+	CheckFlushes();
