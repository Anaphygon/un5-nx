+				GSVertex v = m_un5.last[j];
+				v.XYZ.Z = slot;
+				m_un5.vertex.push_back(v);
+			}
+			m_un5.box_min = m_un5.box_min.min(m_un5.last_box_min);
+			m_un5.box_max = m_un5.box_max.max(m_un5.last_box_max);
+		}
+	}
+
+	const u32 slot = static_cast<u32>(m_un5.consts.size() / UN5_CONSTS_PER_BATCH);
+	m_un5.consts.insert(m_un5.consts.end(), std::begin(c), std::end(c));
+	const u32 base = static_cast<u32>(m_un5.vertex.size());
+	int raw_min[5] = {INT_MAX, INT_MAX, INT_MAX, INT_MAX, INT_MAX}; // x y z u v
+	int raw_max[5] = {INT_MIN, INT_MIN, INT_MIN, INT_MIN, INT_MIN};
