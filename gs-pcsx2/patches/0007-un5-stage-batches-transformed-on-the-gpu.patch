+	if (m_index->tail > 0 && (!m_un5.pending || !room))
+		Flush(GSFlushReason::CONTEXTCHANGE);
+
+	GSVector4 c[UN5_CONSTS_PER_BATCH];
+	for (u32 i = 0; i < 7; i++)
+		c[i] = GSVector4::load<false>(packet + 48 + i * 16);
+	const GSVector4 vf16 = GSVector4::load<false>(packet + 48 + 7 * 16);
+	float uv_z;
+	memcpy(&uv_z, &info[3], sizeof(uv_z));
+	c[7] = GSVector4(vf16.x, vf16.w, uv_z, 0.0f);
+
+	if (!m_un5.pending)
+	{
+		m_un5.box_min = m_un5.uv_min = GSVector4(FLT_MAX);
+		m_un5.box_max = m_un5.uv_max = GSVector4(-FLT_MAX);
+		for (int i = 0; i < 4; i++)
+		{
+			m_un5.colour_min[i] = 255;
+			m_un5.colour_max[i] = 0;
+		}
+		m_un5.fog_min = 255.0f;
+		m_un5.fog_max = 0.0f;
+	}
+
+	// The two vertices the strip goes on from, if they were drawn already.
+	u32 prev[2] = {0, 0};
+	const bool chain = m_un5.chain;
+	if (chain)
