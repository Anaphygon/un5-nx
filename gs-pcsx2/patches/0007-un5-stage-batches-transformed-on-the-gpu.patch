+		const s16 u = static_cast<s16>(w[3]), t = static_cast<s16>(w[3] >> 16);
+		GSVertex v;
+		v.ST.S = x / 4096.0f;
+		v.ST.T = y / 4096.0f;
+		v.RGBAQ.U32[0] = w[2];
+		v.RGBAQ.Q = z / 4096.0f;
+		v.XYZ.X = static_cast<u16>(u);
+		v.XYZ.Y = static_cast<u16>(t);
+		v.XYZ.Z = slot;
+		v.UV = 0;
+		v.FOG = 0;
+		m_un5.vertex.push_back(v);
+		const int values[5] = {x, y, z, u, t};
+		for (int i = 0; i < 5; i++)
+		{
+			raw_min[i] = std::min(raw_min[i], values[i]);
+			raw_max[i] = std::max(raw_max[i], values[i]);
+		}
+		const int colour[4] = {static_cast<int>(w[2] & 0xFF), static_cast<int>((w[2] >> 8) & 0xFF), static_cast<int>((w[2] >> 16) & 0xFF),
+			static_cast<int>((w[2] >> 24) * alpha_scale)};
+		for (int i = 0; i < 4; i++)
+		{
+			m_un5.colour_min[i] = std::min(m_un5.colour_min[i], colour[i]);
+			m_un5.colour_max[i] = std::max(m_un5.colour_max[i], colour[i]);
+		}
+
+		if ((w[1] >> 16) != 0 || (k < 2 && !chain))
+			continue;
+		const u32 i0 = k >= 2 ? base + k - 2 : (k == 1 ? prev[1] : prev[0]);
+		const u32 i1 = k >= 1 ? base + k - 1 : prev[1];
+		m_un5.index.push_back(static_cast<u16>(i0));
+		m_un5.index.push_back(static_cast<u16>(i1));
+		m_un5.index.push_back(static_cast<u16>(base + k));
+	}
+
+	// The batch's screen box, from the corners of its position box: the
+	// whole screen when one is near or behind the eye.
+	GSVector4 box_min(FLT_MAX), box_max(-FLT_MAX);
+	bool behind = false;
+	for (u32 corner = 0; corner < 8; corner++)
+	{
+		const float x = ((corner & 1) ? raw_max[0] : raw_min[0]) / 4096.0f;
+		const float y = ((corner & 2) ? raw_max[1] : raw_min[1]) / 4096.0f;
+		const float z = ((corner & 4) ? raw_max[2] : raw_min[2]) / 4096.0f;
+		const GSVector4 clip = c[0] * GSVector4(x) + c[1] * GSVector4(y) + c[2] * GSVector4(z) + c[3];
+		if (clip.w < 1e-3f)
