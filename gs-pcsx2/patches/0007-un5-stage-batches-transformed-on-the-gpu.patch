+// SPDX-License-Identifier: GPL-3.0+
+// un5-nx: the vertex shader for UN5's stage batches (GSState::UN5NativeBatch),
+// in place of tfx_vgs.glsl's vs_main, whose programs it leaves untouched. Its
+// outputs and uniform block are tfx_vgs.glsl's.
+
+//#version 420 // Keep it for text editor detection
+
+layout(std140, binding = 1) uniform cb20
+{
+	vec2  VertexScale;
+	vec2  VertexOffset;
+
+	vec2  TextureScale;
+	vec2  TextureOffset;
+
+	vec2  PointSize;
+
+	uint  MaxDepth;
+	float LineAA1Width;
+};
+
+// 8 vec4 per batch: the matrix columns, the guard band (unused here), fog
+// (min, max, base, per w) and (near, alpha scale, uv z, 0).
+layout(std430, binding = 6) readonly buffer cb_un5
+{
+	vec4 un5_consts[];
+};
+
+out SHADER
+{
+	vec4 t_float;
+	vec4 t_int;
+	#if VS_IIP != 0
+		vec4 c;
+	#else
+		flat vec4 c;
+	#endif
+	float inv_cov;
+	flat uint interior;
+} VSout;
+
+const float exp_min32 = exp2(-32.0f);
+
+// A vertex: x, y, z / 4096 in ST and Q, int16 u, v in XY, its RGBA, and its
+// batch in Z.
+layout(location = 0) in vec2  i_st;
+layout(location = 2) in uvec4 i_c;
+layout(location = 3) in float i_q;
+layout(location = 4) in uvec2 i_p;
+layout(location = 5) in uint  i_z;
+
+void vs_main()
+{
+	uint slot = i_z * 8u;
+	vec4 clip = un5_consts[slot] * i_st.x + un5_consts[slot + 1u] * i_st.y + un5_consts[slot + 2u] * i_q + un5_consts[slot + 3u];
+	vec4 fog = un5_consts[slot + 6u];
+	vec4 misc = un5_consts[slot + 7u];
+
+	// The GS position is 16 xyz / w, truncated as the program's FTOI4 does:
+	// the other passes over this geometry come from the program's own
+	// output, and pass their z tests only on the same depth. Z goes a little
+	// further (GS z grows towards the eye) to stay below theirs where float
+	// rounding differs from the VU's, and stays inside the depth range. The
+	// GPU clips at the program's near plane, where it ran its clipper; behind
+	// the eye the position stays homogeneous for that.
+	gl_ClipDistance[0] = clip.w - misc.x;
+	vec3 gs;
+	if (clip.w > 0.0f)
+	{
+		gs = trunc(16.0f * clip.xyz / clip.w);
+		gs.z = clamp(gs.z - 8.0f - gs.z * exp2(-20.0f), 0.0f, 4294967040.0f);
+		gs *= clip.w;
+	}
+	else
+	{
+		gs = 16.0f * clip.xyz;
+	}
+	gl_Position.xy = (gs.xy - 0.05f * clip.w) * VertexScale - VertexOffset * clip.w;
+	#if HAS_CLIP_CONTROL
+		gl_Position.z = gs.z * exp_min32;
+	#else
+		gl_Position.z = 2.0f * gs.z * exp_min32 - clip.w;
+	#endif
+	gl_Position.w = clip.w;
+
+	// ST / Q is uv / uv z; interpolated with w, so Q stays 1.
+	ivec2 uv = (ivec2(i_p) << 16) >> 16;
+	vec2 st = vec2(uv) / (4096.0f * misc.z) - TextureOffset;
+	VSout.t_float = vec4(st, floor(clamp(fog.z + clip.w * fog.w, fog.x, fog.y)) / 255.0f, 1.0f);
+	VSout.t_int = vec4(0.0f, 0.0f, st / TextureScale);
+	VSout.c = vec4(vec3(i_c.rgb), floor(float(i_c.a) * misc.y));
+	VSout.inv_cov = 0.0f;
+	VSout.interior = 1u;
+}
