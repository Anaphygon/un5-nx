+		box_max = GSVector4(65535.0f, 65535.0f, 4294967040.0f, 0.0f);
+	}
+	box_min = box_min.max(GSVector4(0.0f)).min(GSVector4(65535.0f, 65535.0f, 4294967040.0f, 0.0f));
+	box_max = box_max.max(GSVector4(0.0f)).min(GSVector4(65535.0f, 65535.0f, 4294967040.0f, 0.0f));
+	m_un5.box_min = m_un5.box_min.min(box_min);
+	m_un5.box_max = m_un5.box_max.max(box_max);
+	const float uv_scale = 1.0f / (4096.0f * uv_z);
+	m_un5.uv_min = m_un5.uv_min.min(GSVector4(raw_min[3] * uv_scale, raw_min[4] * uv_scale, 0.0f, 0.0f));
+	m_un5.uv_max = m_un5.uv_max.max(GSVector4(raw_max[3] * uv_scale, raw_max[4] * uv_scale, 0.0f, 0.0f));
+	m_un5.fog_min = std::min(m_un5.fog_min, std::clamp(c[6].x, 0.0f, 255.0f));
+	m_un5.fog_max = std::max(m_un5.fog_max, std::clamp(c[6].y, 0.0f, 255.0f));
+
+	m_un5.chain = count >= 2;
+	if (m_un5.chain)
+	{
+		m_un5.last[0] = m_un5.vertex[base + count - 2];
+		m_un5.last[1] = m_un5.vertex[base + count - 1];
+		std::copy(std::begin(c), std::end(c), std::begin(m_un5.last_consts));
+		m_un5.last_box_min = box_min;
+		m_un5.last_box_max = box_max;
+		m_un5.last_at = base + count - 2;
+	}
+
+	m_un5_stats.batches++;
+	if (m_un5.index.empty())
+	{
+		m_un5_stats.empty++;
+		// Nothing to draw yet: only last[] is kept, for the strip's next batch.
+		UN5EndDraw();
+		return;
+	}
+
+	// The draw's rectangle, as VertexKick keeps it (exclusive end, in pixels).
+	const GSVector4i rect = GSVector4i(static_cast<int>(box_min.x) - m_xyof.x, static_cast<int>(box_min.y) - m_xyof.y,
+		static_cast<int>(box_max.x) - m_xyof.x, static_cast<int>(box_max.y) - m_xyof.y).sra32<4>() + GSVector4i(0, 0, 1, 1);
+	temp_draw_rect = (m_un5.pending ? temp_draw_rect.runion(rect) : rect).rintersect(m_context->scissor.in);
+	if (m_un5.pending)
+		return;
+
+	// The first primitive of a draw: what VertexKick does then.
+	const int ctx = m_env.PRIM.CTXT;
+	std::memcpy(&m_prev_env, &m_env, 88);
+	std::memcpy(&m_prev_env.CTXT[ctx], &m_env.CTXT[ctx], 96);
+	std::memcpy(&m_prev_env.CTXT[ctx].offset, &m_env.CTXT[ctx].offset, sizeof(m_env.CTXT[ctx].offset));
+	std::memcpy(&m_prev_env.CTXT[ctx].scissor, &m_env.CTXT[ctx].scissor, sizeof(m_env.CTXT[ctx].scissor));
+	m_dirty_gs_regs = 0;
+	m_backed_up_ctx = ctx;
+	m_un5.pending = true;
+	// The proxy's three vertices and indices; their values are written when
+	// the draw is flushed (UN5WriteProxy).
+	GSVertexBuff& vtx_buff = *m_vertex;
+	GSIndexBuff& idx_buff = *m_index;
+	idx_buff.buff[0] = 0;
+	idx_buff.buff[1] = 1;
+	idx_buff.buff[2] = 2;
+	idx_buff.tail = 3;
+	vtx_buff.head = vtx_buff.tail = vtx_buff.next = 3;
+	vtx_buff.xy_tail = 0;
+}
+
+void GSState::UN5WriteProxy()
+{
+	GSVertex* v = m_vertex->buff;
+	const GSVector4 lo = m_un5.box_min, hi = m_un5.box_max;
+	for (u32 i = 0; i < 3; i++)
+	{
+		const bool right = i == 1, bottom = i == 2;
+		v[i].ST.S = right ? m_un5.uv_max.x : m_un5.uv_min.x;
+		v[i].ST.T = bottom ? m_un5.uv_max.y : m_un5.uv_min.y;
+		const int* c = i == 0 ? m_un5.colour_min : m_un5.colour_max;
+		v[i].RGBAQ.R = static_cast<u8>(c[0]);
+		v[i].RGBAQ.G = static_cast<u8>(c[1]);
+		v[i].RGBAQ.B = static_cast<u8>(c[2]);
+		v[i].RGBAQ.A = static_cast<u8>(std::clamp(c[3], 0, 255));
+		v[i].RGBAQ.Q = 1.0f;
+		v[i].XYZ.X = static_cast<u16>(right ? hi.x : lo.x);
+		v[i].XYZ.Y = static_cast<u16>(bottom ? hi.y : lo.y);
+		v[i].XYZ.Z = static_cast<u32>(i == 0 ? lo.z : hi.z);
+		v[i].UV = 0;
+		v[i].FOG = static_cast<u32>(i == 0 ? m_un5.fog_min : m_un5.fog_max);
+	}
+}
+
+void GSState::UN5EndDraw()
+{
+	if (m_un5.pending)
+	{
+		m_un5_stats.draws++;
+		m_un5_stats.triangles += m_un5.index.size() / 3;
+		// UN5GS_NATIVE_LOG=n: the state of the first n native draws, for checking.
+		static int s_log = std::getenv("UN5GS_NATIVE_LOG") ? std::atoi(std::getenv("UN5GS_NATIVE_LOG")) : 0;
+		if (s_log > 0)
+		{
+			s_log--;
+			const GSDrawingContext& c = m_env.CTXT[PRIM->CTXT];
+			Console.WriteLn("[stage-draw] prim %03X test %08X zbuf %08X%08X alpha %010llX frame %08X%08X tex0 %016llX: %zu verts %zu tris %zu batches, box %.0f..%.0f %.0f..%.0f z %.0f..%.0f uv %.3f..%.3f %.3f..%.3f",
+				PRIM->U32[0], c.TEST.U32[0], c.ZBUF.U32[1], c.ZBUF.U32[0], static_cast<unsigned long long>(c.ALPHA.U64), c.FRAME.U32[1], c.FRAME.U32[0],
+				static_cast<unsigned long long>(c.TEX0.U64), m_un5.vertex.size(), m_un5.index.size() / 3, m_un5.consts.size() / 8,
+				m_un5.box_min.x, m_un5.box_max.x, m_un5.box_min.y, m_un5.box_max.y, m_un5.box_min.z, m_un5.box_max.z,
+				m_un5.uv_min.x, m_un5.uv_max.x, m_un5.uv_min.y, m_un5.uv_max.y);
+		}
+	}
+	m_un5.pending = false;
+	m_un5.vertex.clear();
+	m_un5.index.clear();
+	m_un5.consts.clear();
+	m_un5.last_at = 0xFFFFFFFFu - 2;
+}
