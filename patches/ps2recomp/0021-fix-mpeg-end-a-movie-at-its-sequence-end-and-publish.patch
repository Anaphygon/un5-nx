+        // un5-nx: one uncapped line per call site every 120 VSync ticks, so a
+        // stalled movie can be told from a slow one (the per-event traces stop
+        // after their first 32 lines).
+        void logMpegStatusUnlocked(const char *where, uint32_t mpegAddr, const MpegPlaybackState &playback, PS2Runtime *runtime)
+        {
+            if (!runtime)
+                return;
+            static std::unordered_map<std::string, uint64_t> s_lastTick;
+            const uint64_t tick = runtime->eeScheduler().currentVSyncTick();
+            uint64_t &last = s_lastTick[where];
+            if (last != 0u && tick < last + 120u)
+                return;
+            last = tick;
+            const uint64_t tickQ32 = tick << 32u;
+            const int64_t nextDue = playback.nextPictureTickQ32 == std::numeric_limits<uint64_t>::max()
+                                        ? -1
+                                        : static_cast<int64_t>(playback.nextPictureTickQ32 >> 32u);
+            std::cerr << "[MPEG:status] tick=" << tick << " at=" << where << " mpeg=0x" << std::hex << mpegAddr << std::dec
+                      << " served=" << playback.picturesServed << " queued=" << playback.decodedFrames.size()
+                      << " pssBuf=" << playback.pssBuffer.size() << " nextDue=" << nextDue
+                      << " ended=" << playback.streamEnded << " failed=" << playback.decoderFailed
+                      << " eofSeen=" << g_mpeg_stub_state.currentCdStreamEofSeen
+                      << " produced=" << g_mpeg_stub_state.cdStreamBytesProduced
+                      << " demuxed=" << g_mpeg_stub_state.cdStreamBytesDemuxed
+                      << " behind=" << (tickQ32 > playback.nextPictureTickQ32 ? 1 : 0) << std::endl;
+        }
