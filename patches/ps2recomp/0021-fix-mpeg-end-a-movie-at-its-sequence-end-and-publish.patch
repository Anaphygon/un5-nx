diff --git a/ps2xTest/src/ps2_runtime_expansion_tests.cpp b/ps2xTest/src/ps2_runtime_expansion_tests.cpp
index 4772f3f..6c3692a 100644
--- a/ps2xTest/src/ps2_runtime_expansion_tests.cpp
+++ b/ps2xTest/src/ps2_runtime_expansion_tests.cpp
@@ -231,6 +231,50 @@ namespace
         ps2_stubs::sceMpegGetPicture(rdram, ctx, runtime);
     }
 
+    constexpr uint32_t kMpegEndInner = 0x00191000u;
+    constexpr uint32_t kMpegEndResumePc = 0x00125030u;
+    constexpr uint32_t kMpegEndFinalPc = 0x00125040u;
+
+    void testMpegEndFinal(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        gMpegWaitStage.store(4u, std::memory_order_release);
+        ctx->pc = 0u;
+        runtime->requestStop();
+    }
+
+    // After EOF the game keeps asking for pictures each frame; the end is
+    // reported once the last picture has had its display time.
+    void testMpegEndResume(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        gMpegWaitStage.store(3u, std::memory_order_release);
+        ctx->pc = kMpegEndFinalPc;
+        EeScheduler &ee = runtime->eeScheduler();
+        ee.waitVSync(ee.currentVSyncTick() + 4u, -1, [rdram, runtime](R5900Context &resumeContext)
+                     {
+                         setRegU32(resumeContext, 4, kMpegWaitHandle);
+                         setRegU32(resumeContext, 5, kMpegWaitImage);
+                         ps2_stubs::sceMpegGetPicture(rdram, &resumeContext, runtime);
+                     });
+    }
+
+    void testMpegEndFlagMain(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        // libmpeg keeps its internal state behind sceMpeg+0x40; games inline
+        // sceMpegIsEnd as a read of that struct's first word.
+        std::memcpy(rdram + kMpegWaitHandle + 0x40u, &kMpegEndInner, sizeof(kMpegEndInner));
+        // One picture first, as in a real movie: a stream that never had input
+        // is not "finished" by EOF.
+        ps2_stubs::enqueueMpegDecodedFrameForTesting(kMpegWaitHandle);
+        setRegU32(*ctx, 4, kMpegWaitHandle);
+        setRegU32(*ctx, 5, kMpegWaitImage);
+        ps2_stubs::sceMpegGetPicture(rdram, ctx, runtime);
+        gMpegWaitStage.store(1u, std::memory_order_release);
+        setRegU32(*ctx, 4, kMpegWaitHandle);
+        setRegU32(*ctx, 5, kMpegWaitImage);
+        ctx->pc = kMpegEndResumePc;
+        ps2_stubs::sceMpegGetPicture(rdram, ctx, runtime);
+    }
+
     void testMpegWaitResume(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
     {
         gMpegWaitStage.store(3u, std::memory_order_release);
@@ -779,6 +823,35 @@ void register_ps2_runtime_expansion_tests()
                      "resumed GetPicture should publish the configured height");
         });
 
+        tc.Run("sceMpegGetPicture publishes the end of a movie where an inline sceMpegIsEnd reads it", [](TestCase &t)
+        {
+            PS2Runtime runtime;
+            std::vector<uint8_t> rdram(PS2_RAM_SIZE, 0u);
+            ps2_stubs::resetMpegStubState();
+            ps2_stubs::notifyMpegCdStreamStart();
+            runtime.registerFunction(kMpegWaitMainPc, testMpegEndFlagMain);
+            runtime.registerFunction(kMpegEndResumePc, testMpegEndResume);
+            runtime.registerFunction(kMpegEndFinalPc, testMpegEndFinal);
+            runtime.registerFunction(kMpegWaitProducerPc, testMpegWaitProducer);
+            gMpegWaitResult.store(-999, std::memory_order_release);
+            gMpegWaitStage.store(0u, std::memory_order_release);
+
+            R5900Context mainContext{};
+            mainContext.pc = kMpegWaitMainPc;
+            EeScheduler &ee = runtime.eeScheduler();
+            ee.reset(rdram.data(), mainContext);
+            const int producerId = ee.createThread(EeThreadCreateParams{
+                0u, kMpegWaitProducerPc, 0u, 0u, 0u, 10, 0u});
+            ee.startThread(producerId, 0u, mainContext, false);
+            ee.run();
+
+            t.Equals(gMpegWaitStage.load(std::memory_order_acquire), 4u,
+                     "GetPicture should resume after EOF and once more a few fields later");
+            // SLES-55605 loops on that word until it reads 1; nothing set it.
+            t.Equals(Ps2FastRead32(rdram.data(), kMpegEndInner), 1u,
+                     "a finished movie should set the inline end flag");
+        });
+
         tc.Run("sceMpegGetPicture waits for new decoder output instead of duplicating the last frame", [](TestCase &t)
