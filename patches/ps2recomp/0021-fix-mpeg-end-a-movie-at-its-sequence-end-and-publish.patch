+        // The movie ended without a disc EOF: its sequence_end_code was demuxed
+        // in this stream generation, every byte read from the disc has been
+        // demuxed and nothing is left buffered. Games stop reading once only a
+        // partial last sector is left (SLES-55605 treats <= 4 bytes as done),
+        // so the stream never reaches its end LBN and the EOF never comes.
+        bool sequenceEndDrainedUnlocked(const MpegPlaybackState &playback)
+        {
+            return playback.sawSequenceEnd &&
+                   playback.cdStreamGeneration == g_mpeg_stub_state.cdStreamGeneration &&
+                   playback.pssBuffer.empty() &&
+                   g_mpeg_stub_state.cdStreamBytesProduced != 0u &&
+                   g_mpeg_stub_state.cdStreamBytesDemuxed >= g_mpeg_stub_state.cdStreamBytesProduced;
+        }
+
+        // What sceMpegIsEnd reports: the stream is over, every picture has been
+        // handed out and the last one has had its display time.
+        bool mpegPlaybackFinishedUnlocked(const MpegPlaybackState &playback, PS2Runtime *runtime)
+        {
+            const bool producerEnded =
+                (g_mpeg_stub_state.currentCdStreamEofSeen &&
+                 playback.cdStreamGeneration == g_mpeg_stub_state.cdStreamGeneration) ||
+                (playback.streamEnded && sequenceEndDrainedUnlocked(playback));
+            const bool ended = producerEnded &&
+                               (playback.streamEnded || (playback.decoderFailed && playback.sawInput));
+            const uint64_t presentationEnd = playback.presentationEndTickQ32;
+            const uint64_t currentTickQ32 = runtime != nullptr
+                                                ? (runtime->eeScheduler().currentVSyncTick() << 32u)
+                                                : std::numeric_limits<uint64_t>::max();
+            const bool presentationComplete =
+                presentationEnd == std::numeric_limits<uint64_t>::max() || currentTickQ32 >= presentationEnd;
+            return ended && playback.decodedFrames.empty() && presentationComplete;
+        }
