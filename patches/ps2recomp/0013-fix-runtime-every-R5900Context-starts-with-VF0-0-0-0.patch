From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 26 Oct 2026 17:22:28 +0700
Subject: [PATCH 13/17] fix(runtime): every R5900Context starts with VF0 = (0,
 0, 0, 1)

The constructor zeroed the whole context, VF0 included, and only the
main CPU context set it back. Each EE thread starts from a fresh
context, so in every game thread VF0 read as zero. VF0 is hardwired on
the VU, and games build identity matrices and w = 1 from it:
SLES-55605's screen matrix came out all zero, every sprite projected to
(0, 0), fell outside the clip window and was never drawn.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ps2xRuntime/include/ps2_runtime.h         |  5 ++++-
 ps2xTest/src/ps2_runtime_kernel_tests.cpp | 26 +++++++++++++++++++++++
 2 files changed, 30 insertions(+), 1 deletion(-)

diff --git a/ps2xRuntime/include/ps2_runtime.h b/ps2xRuntime/include/ps2_runtime.h
index 5f90971..3dde3a3 100644
--- a/ps2xRuntime/include/ps2_runtime.h
+++ b/ps2xRuntime/include/ps2_runtime.h
@@ -148,7 +148,10 @@ struct alignas(16) R5900Context
     {
         std::memset(this, 0, sizeof(*this));
 
-        // Initialize VU0 registers
+        // Initialize VU0 registers. VF0 is hardwired to (0, 0, 0, 1); games
+        // build identity matrices and w = 1 from it, so every context (each
+        // EE thread starts from a fresh one) must carry it.
+        vu0_vf[0] = _mm_set_ps(1.0f, 0.0f, 0.0f, 0.0f);
         vu0_q = 1.0f; // Q register usually initialized to 1.0
 
         // Reset COP0 registers
diff --git a/ps2xTest/src/ps2_runtime_kernel_tests.cpp b/ps2xTest/src/ps2_runtime_kernel_tests.cpp
index 063a915..1005d05 100644
--- a/ps2xTest/src/ps2_runtime_kernel_tests.cpp
+++ b/ps2xTest/src/ps2_runtime_kernel_tests.cpp
@@ -572,6 +572,32 @@ void register_ps2_runtime_kernel_tests()
                      "SET_GPR_U32 must preserve the upper 64 bits of the 128-bit GPR");
         });
 
+        tc.Run("a started EE thread sees VF0 as (0, 0, 0, 1)", [](TestCase &t)
+        {
+            TestEnv env;
+            env.runtime.registerFunction(K_SCHED_HIGH, [](uint8_t *, R5900Context *, PS2Runtime *) {});
+            EeThreadCreateAbi threadParam{};
+            threadParam.func = K_SCHED_HIGH;
+            threadParam.stack = 0x00018000u;
+            threadParam.stack_size = 0x1000;
+            threadParam.initial_priority = 100;
+            std::memcpy(env.rdram.data() + K_PARAM_ADDR, &threadParam, sizeof(threadParam));
+            setRegU32(env.ctx, 4, K_PARAM_ADDR);
+            CreateThread(env.rdram.data(), &env.ctx, &env.runtime);
+            const int id = getRegS32(env.ctx, 2);
+            setRegU32(env.ctx, 4, static_cast<uint32_t>(id));
+            setRegU32(env.ctx, 5, 0u);
+            StartThread(env.rdram.data(), &env.ctx, &env.runtime);
+            t.Equals(getRegS32(env.ctx, 2), id, "StartThread should start the thread");
+
+            // VF0 is hardwired; SLES-55605 builds its identity matrices from it,
+            // and a zero VF0 left every sprite projected to (0, 0) and clipped.
+            float vf0[4];
+            _mm_storeu_ps(vf0, env.runtime.eeScheduler().thread(id)->context.vu0_vf[0]);
+            t.IsTrue(vf0[0] == 0.0f && vf0[1] == 0.0f && vf0[2] == 0.0f && vf0[3] == 1.0f,
+                     "a new thread's VF0 should be (0, 0, 0, 1)");
+        });
+
         tc.Run("EE thread calls return the thread ID on success", [](TestCase &t)
         {
             TestEnv env;
