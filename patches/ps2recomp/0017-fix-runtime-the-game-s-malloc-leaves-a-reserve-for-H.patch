+    // Heap kept free of the game's own allocations for the runtime's HLE code
+    // (at most; see leavesRuntimeReserveLocked).
+    constexpr uint64_t kGuestHeapRuntimeReserve = 0x00100000u;
 
     constexpr uint32_t COP0_CAUSE_EXCCODE_MASK = 0x0000007Cu;
     constexpr uint32_t COP0_CAUSE_BD = 0x80000000u;
@@ -1849,6 +1852,72 @@ uint32_t PS2Runtime::guestMalloc(uint32_t size, uint32_t alignment)
     return allocateGuestBlockLocked(size, alignment);
 }
 
+bool PS2Runtime::leavesRuntimeReserveLocked(uint64_t extraBytes) const
+{
+    uint64_t freeBytes = 0u;
+    for (const GuestHeapBlock &block : m_guestHeapBlocks)
+    {
+        if (block.free)
+            freeBytes += block.size;
+    }
+    // A sixteenth of a small heap, so tiny heaps stay usable by the game.
+    const uint64_t heapSize = m_guestHeapLimit > m_guestHeapBase ? m_guestHeapLimit - m_guestHeapBase : 0u;
+    const uint64_t reserve = std::min<uint64_t>(kGuestHeapRuntimeReserve, heapSize / 16u);
+    return freeBytes >= extraBytes + reserve;
+}
+
+uint32_t PS2Runtime::guestMallocForGame(uint32_t size, uint32_t alignment)
+{
+    std::lock_guard<std::mutex> lock(m_guestHeapMutex);
+    ensureGuestHeapInitializedLocked();
+    if (!leavesRuntimeReserveLocked(alignGuestHeapValue(size, kGuestHeapDefaultAlignment)))
+    {
+        return 0u;
+    }
+    return allocateGuestBlockLocked(size, alignment);
+}
+
+uint32_t PS2Runtime::guestCallocForGame(uint32_t count, uint32_t size, uint32_t alignment)
+{
+    if (count == 0u || size == 0u || count > (std::numeric_limits<uint32_t>::max() / size))
+    {
+        return 0u;
+    }
+    const uint32_t totalSize = count * size;
+    const uint32_t guestAddr = guestMallocForGame(totalSize, alignment);
+    uint8_t *rdram = m_memory.getRDRAM();
+    if (guestAddr != 0u && rdram)
+    {
+        const uint32_t physAddr = guestAddr & PS2_RAM_MASK;
+        if (physAddr + totalSize <= PS2_RAM_SIZE)
+            std::memset(rdram + physAddr, 0, totalSize);
+    }
+    return guestAddr;
+}
+
+uint32_t PS2Runtime::guestReallocForGame(uint32_t guestAddr, uint32_t newSize, uint32_t alignment)
+{
+    if (guestAddr == 0u)
+    {
+        return guestMallocForGame(newSize, alignment);
+    }
+    {
+        std::lock_guard<std::mutex> lock(m_guestHeapMutex);
+        ensureGuestHeapInitializedLocked();
+        const int32_t index = findGuestHeapBlockIndexLocked(guestAddr);
+        if (index >= 0)
+        {
+            const uint64_t oldSize = m_guestHeapBlocks[static_cast<size_t>(index)].size;
+            const uint64_t wanted = alignGuestHeapValue(newSize, kGuestHeapDefaultAlignment);
+            if (wanted > oldSize && !leavesRuntimeReserveLocked(wanted - oldSize))
+            {
+                return 0u;
+            }
+        }
+    }
+    return guestRealloc(guestAddr, newSize, alignment);
+}
+
 uint32_t PS2Runtime::guestCalloc(uint32_t count, uint32_t size, uint32_t alignment)
 {
     if (count == 0u || size == 0u)
