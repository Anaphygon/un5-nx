+        tc.Run("the game's malloc leaves heap for the runtime", [](TestCase &t)
+        {
+            TestEnv env;
+            // 1 MiB heap: the game's allocations must leave 1/16 of it free.
+            env.runtime.configureGuestHeap(0x00200000u, 0x00300000u);
+
+            // SLES-55605 asks malloc for ever smaller blocks until one fits, to
+            // take all memory for its own allocator.
+            uint32_t got = 0u;
+            uint32_t size = 0x00100000u;
+            for (; size >= 0x1000u && got == 0u; size -= 0x1000u)
+            {
+                setRegU32(env.ctx, 4, size);
+                ps2_stubs::malloc(env.rdram.data(), &env.ctx, &env.runtime);
+                got = ::getRegU32(&env.ctx, 2);
+            }
+            t.IsTrue(got != 0u, "a probing malloc should still get most of the heap");
+            t.IsTrue(size + 0x1000u <= 0x00100000u - 0x00010000u, "the game should not get the runtime's reserve");
+
+            // HLE code (MPEG stream callbacks, thread stacks) allocates here.
+            t.IsTrue(env.runtime.guestMalloc(0x40u) != 0u, "the runtime should still allocate after the game took its share");
+        });
+
         tc.Run("allocator compatibility stubs use the runtime guest heap", [](TestCase &t)
