+++ b/ps2xRuntime/include/ps2_runtime.h
@@ -385,6 +385,13 @@ public:
     uint32_t guestCalloc(uint32_t count, uint32_t size, uint32_t alignment = 16u);
     uint32_t guestRealloc(uint32_t guestAddr, uint32_t newSize, uint32_t alignment = 16u);
     void guestFree(uint32_t guestAddr);
+    // The game's own malloc/calloc/realloc go through these. They leave a
+    // reserve free for the runtime's HLE allocations (MPEG callback data,
+    // thread stacks...), which games that probe for the largest block they
+    // can get would otherwise take.
+    uint32_t guestMallocForGame(uint32_t size, uint32_t alignment = 16u);
+    uint32_t guestCallocForGame(uint32_t count, uint32_t size, uint32_t alignment = 16u);
+    uint32_t guestReallocForGame(uint32_t guestAddr, uint32_t newSize, uint32_t alignment = 16u);
     uint32_t guestHeapBase() const;
     uint32_t guestHeapEnd() const;
     uint32_t guestHeapLimit() const;
@@ -483,6 +490,7 @@ private:
     uint32_t allocateGuestBlockLocked(uint32_t size, uint32_t alignment);
     void freeGuestBlockLocked(uint32_t guestAddr);
     void coalesceGuestHeapLocked();
+    bool leavesRuntimeReserveLocked(uint64_t extraBytes) const;
     void HandleIntegerOverflow(R5900Context *ctx);
 
