From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 26 Oct 2026 21:36:03 +0700
Subject: [PATCH 18/20] fix(dma): a VIF chain leaves MADR just past the last
 data it moved

After a chain stops, MADR points one past the data of the last tag, as
on the DMAC; the runtime never updated it. SLES-55605 splits its frame
chain with END tags and, in its DMAC interrupt handler, finds the END
tag at MADR - 0x10 to run the callback stored in that packet and restart
the chain. With a stale MADR the handler took the error path, reset GS
and DMA, and the movie player never got its frames released.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ps2xRuntime/src/lib/ps2_memory.cpp |  8 ++++++++
 ps2xTest/src/ps2_memory_tests.cpp  | 29 +++++++++++++++++++++++++++++
 2 files changed, 37 insertions(+)

diff --git a/ps2xRuntime/src/lib/ps2_memory.cpp b/ps2xRuntime/src/lib/ps2_memory.cpp
index ab41423..9233e00 100644
--- a/ps2xRuntime/src/lib/ps2_memory.cpp
+++ b/ps2xRuntime/src/lib/ps2_memory.cpp
@@ -1408,6 +1408,10 @@ bool PS2Memory::writeIORegister(uint32_t address, uint32_t value)
 
                     int tagsProcessed = 0;
                     uint32_t lastTagUpper = (chcr >> 16) & 0xFFFFu;
+                    // MADR ends one past the last data the chain moved. Games rely on
+                    // it: SLES-55605's DMAC handler finds the END tag it stopped on at
+                    // MADR - 0x10 and runs the callback stored in that packet.
+                    uint32_t endMadr = m_ioRegisters[channelBase + 0x10];
 
                     while (tagsProcessed < kMaxChainTags)
                     {
@@ -1516,6 +1520,8 @@ bool PS2Memory::writeIORegister(uint32_t address, uint32_t value)
 
                         if (transferTagData)
                             appendVifTagData(currentTagAddr);
+                        if (id <= 7u)
+                            endMadr = dataAddr + static_cast<uint32_t>(tagQwc) * 16u;
 
                         if (hasPayload)
                             appendData(dataAddr, tagQwc);
@@ -1525,6 +1531,8 @@ bool PS2Memory::writeIORegister(uint32_t address, uint32_t value)
                             break;
                     }
 
+                    m_ioRegisters[channelBase + 0x10] = endMadr;
+                    m_ioRegisters[channelBase + 0x20] = 0u;
                     m_ioRegisters[channelBase + 0x30] = tagAddr;
                     m_ioRegisters[channelBase + 0x40] = asr0;
                     m_ioRegisters[channelBase + 0x50] = asr1;
diff --git a/ps2xTest/src/ps2_memory_tests.cpp b/ps2xTest/src/ps2_memory_tests.cpp
index d7336d9..801e0d1 100644
--- a/ps2xTest/src/ps2_memory_tests.cpp
+++ b/ps2xTest/src/ps2_memory_tests.cpp
@@ -1418,6 +1418,35 @@ void register_ps2_memory_tests()
             t.Equals(mem.readIORegister(kVif1Ch + 0x20u), 0u, "VIF1 QWC should be cleared after drain");
         });
 
+        tc.Run("VIF1 DMA chain leaves MADR just past the END tag it stopped on", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+
+            constexpr uint32_t kVif1Ch = 0x10009000u;
+            constexpr uint32_t kCnt = 0x00026000u;
+            constexpr uint32_t kEnd = kCnt + 0x20u;   // after the CNT tag and its one qword
+
+            uint8_t *rdram = mem.getRDRAM();
+            std::memset(rdram + kCnt, 0, 0x40u);   // VIF NOPs as payload and in the tags
+            const uint64_t cntTag = 1ull | (1ull << 28);   // CNT, 1 qword
+            const uint64_t endTag = 0ull | (7ull << 28);   // END, no data
+            std::memcpy(rdram + kCnt, &cntTag, sizeof(cntTag));
+            std::memcpy(rdram + kEnd, &endTag, sizeof(endTag));
+
+            t.IsTrue(mem.writeIORegister(kVif1Ch + 0x30u, kCnt), "write VIF1 TADR should succeed");
+            t.IsTrue(mem.writeIORegister(kVif1Ch + 0x20u, 0u), "write VIF1 QWC should succeed");
+            t.IsTrue(mem.writeIORegister(kVif1Ch + 0x00u, 0x145u), "start the VIF1 chain");
+            mem.processPendingTransfers();
+
+            // SLES-55605's DMAC handler reads the END tag at MADR - 0x10 and runs
+            // the callback stored in that packet before restarting the chain.
+            t.Equals(mem.readIORegister(kVif1Ch + 0x10u), kEnd + 0x10u, "MADR should point just past the END tag");
+            t.Equals((mem.readIORegister(kVif1Ch + 0x00u) >> 28) & 7u, 7u, "CHCR should carry the END tag's ID");
+            // As in PCSX2: END leaves TADR on the tag (advancing it breaks Soul Calibur II/III).
+            t.Equals(mem.readIORegister(kVif1Ch + 0x30u), kEnd, "TADR should stay on the END tag");
+        });
+
         tc.Run("VIF1 DMA chain preserves compact tag high bytes for DIRECT packets", [](TestCase &t)
         {
             PS2Memory mem;
-- 
