diff --git a/ps2xIOP/src/emulator/imports/iop_libsd.cpp b/ps2xIOP/src/emulator/imports/iop_libsd.cpp
new file mode 100644
index 0000000..bea969c
--- /dev/null
+++ b/ps2xIOP/src/emulator/imports/iop_libsd.cpp
@@ -0,0 +1,169 @@
+#include "iop_libsd.h"
+
+#include "../core/iop_cpu.h"
+#include "../iop_emulator_const.h"
+#include "../services/iop_rpc.h"
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        // libsd export ordinals (PS2SDK iop/sound/libsd exports.tab; 28 is
+        // past PS2SDK's table, from Sony's libsd 1.5).
+        constexpr uint16_t kSdQuit = 2;
+        constexpr uint16_t kSdInit = 4;
+        constexpr uint16_t kSdGetParam = 6;
+        constexpr uint16_t kSdGetSwitch = 8;
+        constexpr uint16_t kSdGetAddr = 10;
+        constexpr uint16_t kSdGetCoreAttr = 12;
+        constexpr uint16_t kSdVoiceTrans = 17;
+        constexpr uint16_t kSdBlockTrans = 18;
+        constexpr uint16_t kSdVoiceTransStatus = 19;
+        constexpr uint16_t kSdBlockTransStatus = 20;
+        constexpr uint16_t kSdSetTransIntrHandler = 26;
+
+        constexpr uint32_t kTransModeMask = 0x3u;   // SD_TRANS_WRITE, READ, STOP, WRITE_FROM
+        constexpr uint32_t kTransStop = 0x2u;
+        constexpr uint32_t kTransLoop = 0x10u;
+
+        // The SPU2 reads block-transfer input as 48 kHz 16-bit stereo.
+        constexpr uint64_t kBytesPerSecond = 48'000ull * 4ull;
+    }
+
+    void IopLibsd::reset() noexcept
+    {
+        m_channels = {};
+        m_servicing = false;
+    }
+
+    uint64_t IopLibsd::halfCycles(uint32_t size) noexcept
+    {
+        const uint64_t half = size / 2u;
+        const uint64_t cycles = (half * kIopClockHz) / kBytesPerSecond;
+        return cycles ? cycles : 1u;
+    }
+
+    uint32_t IopLibsd::position(const Channel &ch, uint64_t currentCycle) const noexcept
+    {
+        if (!ch.active || ch.size == 0u)
+            return ch.address;
+        const uint64_t perByte = kIopClockHz / kBytesPerSecond;
+        const uint64_t played = perByte ? (currentCycle - ch.start) / perByte : 0u;
+        return ch.address + static_cast<uint32_t>(played % ch.size);
+    }
+
+    bool IopLibsd::dispatchImport(uint16_t ordinal, IopCpuState &cpu, uint64_t currentCycle)
+    {
+        const uint32_t a0 = cpu.gpr[4];
+        const uint32_t a1 = cpu.gpr[5];
+        const uint32_t a2 = cpu.gpr[6];
+        const uint32_t a3 = cpu.gpr[7];
+        auto setV0 = [&](uint32_t value) { cpu.gpr[2] = value; };
+        Channel *ch = (a0 & 1u) < m_channels.size() ? &m_channels[a0 & 1u] : nullptr;
+
+        switch (ordinal)
+        {
+        case kSdQuit:
+        case kSdInit:
+            for (Channel &c : m_channels)
+            {
+                c.active = false;
+                c.nextIrq = UINT64_MAX;
+            }
+            setV0(0);
+            return true;
+        case kSdGetParam:
+        case kSdGetSwitch:
+        case kSdGetAddr:
+        case kSdGetCoreAttr:
+        case kSdVoiceTransStatus:
+            setV0(0);   // idle hardware; VoiceTransStatus 0 is "finished" with SD_TRANS_STATUS_WAIT
+            return true;
+        case kSdVoiceTrans:
+            setV0(a3);  // the whole transfer happened at once: bytes transferred
+            return true;
+        case kSdSetTransIntrHandler:
+            if (ch)
+            {
+                ch->handler = a1;
+                ch->handlerArg = a2;
+                ch->handlerGp = cpu.gpr[28];
+            }
+            setV0(0);
+            return true;
+        case kSdBlockTrans:
+            if (ch)
+            {
+                if ((a1 & kTransModeMask) == kTransStop)
+                {
+                    ch->active = false;
+                    ch->nextIrq = UINT64_MAX;
+                    setV0(0);
+                    return true;
+                }
+                ch->address = a2;
+                ch->size = a3;
+                ch->loop = (a1 & kTransLoop) != 0u;
+                ch->active = a3 != 0u;
+                ch->half = 0u;
+                ch->start = currentCycle;
+                // Loop mode interrupts at each half; one-shot at the end.
+                ch->nextIrq = ch->active ? currentCycle + (ch->loop ? halfCycles(a3) : 2u * halfCycles(a3))
+                                         : UINT64_MAX;
+            }
+            setV0(0);
+            return true;
+        case kSdBlockTransStatus:
+            setV0(ch ? position(*ch, currentCycle) : 0u);
+            return true;
+        default:
+            setV0(0);   // the setters: parameters, switches, addresses, effects
+            return true;
+        }
+    }
+
+    void IopLibsd::serviceDue(uint64_t currentCycle, IopGuestExecutor &executor)
+    {
+        if (m_servicing)
+            return;
+        m_servicing = true;
+        struct Guard
+        {
+            bool &flag;
+            ~Guard() { flag = false; }
+        } guard{m_servicing};
+
+        for (uint32_t index = 0; index < m_channels.size(); ++index)
+        {
+            Channel &ch = m_channels[index];
+            if (!ch.active || ch.nextIrq > currentCycle)
+                continue;
+            if (ch.loop)
+            {
+                ch.half ^= 1u;
+                ch.nextIrq += halfCycles(ch.size);
+            }
+            else
+            {
+                ch.active = false;
+                ch.nextIrq = UINT64_MAX;
+            }
+            if (ch.handler != 0u)
+            {
+                (void)executor.executeGuestFunctionWithBudget(ch.handler, index, ch.handlerArg, 0u, 0u,
+                                                              ch.handlerGp, 100000u);
+            }
+        }
+    }
+
+    uint64_t IopLibsd::nextEventCycle(uint64_t fallback) const noexcept
+    {
+        uint64_t next = fallback;
+        for (const Channel &ch : m_channels)
+        {
+            if (ch.active && ch.nextIrq < next)
+                next = ch.nextIrq;
+        }
+        return next;
+    }
+}
diff --git a/ps2xIOP/src/emulator/imports/iop_libsd.h b/ps2xIOP/src/emulator/imports/iop_libsd.h
new file mode 100644
index 0000000..e202525
--- /dev/null
+++ b/ps2xIOP/src/emulator/imports/iop_libsd.h
@@ -0,0 +1,45 @@
+#pragma once
+
+#include <array>
+#include <cstdint>
+
+namespace ps2x::iop::detail
+{
+    struct IopCpuState;
+    class IopGuestExecutor;
+
+    // libsd for IRX modules that import it (CRI ADX's cri_adxi.irx,
+    // sndbase.irx). No sound yet: it keeps the SPU2 transfer clock running so
+    // a driver that streams through sceSdBlockTrans sees its buffers drain
+    // and its transfer-interrupt handler fire, at the rate the hardware would.
+    class IopLibsd
+    {
+    public:
+        void reset() noexcept;
+
+        [[nodiscard]] bool dispatchImport(uint16_t ordinal, IopCpuState &cpu, uint64_t currentCycle);
+        void serviceDue(uint64_t currentCycle, IopGuestExecutor &executor);
+        [[nodiscard]] uint64_t nextEventCycle(uint64_t fallback) const noexcept;
+
+    private:
+        struct Channel
+        {
+            uint32_t handler = 0u;   // sceSdSetTransIntrHandler
+            uint32_t handlerArg = 0u;
+            uint32_t handlerGp = 0u;
+            uint32_t address = 0u;   // sceSdBlockTrans buffer
+            uint32_t size = 0u;
+            bool loop = false;       // SD_TRANS_LOOP: two halves, forever
+            bool active = false;
+            uint32_t half = 0u;      // which half is being played
+            uint64_t start = 0u;
+            uint64_t nextIrq = UINT64_MAX;
+        };
+
+        [[nodiscard]] static uint64_t halfCycles(uint32_t size) noexcept;
+        [[nodiscard]] uint32_t position(const Channel &ch, uint64_t currentCycle) const noexcept;
+
+        std::array<Channel, 2> m_channels{};
+        bool m_servicing = false;
+    };
+}
