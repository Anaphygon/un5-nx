From 462bf41f8b680a493d7e9b3f0abe5f9f43392f21 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 8 Nov 2026 03:14:59 +0700
Subject: [PATCH] feat: --rounds loads the starting state again every so many
 frames

A scripted run made of many similar parts (UN5's shader harvest: one
round per character from the same Character Select) drifted with fixed
press times: a longer loading in one part moved every later press onto
the wrong screen. With --rounds <frames> the run loads its --load-state
file again at the start of each round, through the same request a quick
load uses. Presses, --frames and the names of dumped frames then count
frames since the start of the run, which a loaded state does not set
back; without --rounds nothing changes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 host/main.cpp                  |  4 +++-
 runtime/include/ps2/system.hpp |  5 +++++
 runtime/src/system.cpp         | 28 +++++++++++++++++++++++-----
 3 files changed, 31 insertions(+), 6 deletions(-)

diff --git a/host/main.cpp b/host/main.cpp
index e13ca4b..14eabdf 100644
--- a/host/main.cpp
+++ b/host/main.cpp
@@ -31,7 +31,7 @@ int usage() {
                  "              [--disc image.iso] [--memcard card.ps2] [--pal | --ntsc] [--trace-syscalls] [--trace-io] [--trace-threads]\n"
                  "              [--trace-iop] [--trace-iop-hle] [--frames-dir dir] [--frame-every n]\n"
                  "              [--press frame:button[+button][:frames]]... [--window] [--fullscreen]\n"
-                 "              [--save-state frame:file] [--load-state file] [--widescreen] [--patches file]\n");
+                 "              [--save-state frame:file] [--load-state file] [--rounds frames] [--widescreen] [--patches file]\n");
     return 2;
 }
 
@@ -139,6 +139,7 @@ int main(int argc, char **argv) {
             ps2::g_options.save_state_path = spec.substr(colon + 1);
         }
         else if (a == "--load-state" && i + 1 < argc) load_path = argv[++i];
+        else if (a == "--rounds" && i + 1 < argc) ps2::g_options.round_frames = std::strtoull(argv[++i], nullptr, 10);
         else return usage();
     }
 
@@ -157,6 +158,7 @@ int main(int argc, char **argv) {
         }
         ps2::boot(entry, args);
         if (!load_path.empty() && !ps2::load_state(load_path)) return 1;
+        ps2::g_options.round_state = load_path;
 #ifdef PS2_PROFILE
         const char *profile = std::getenv("PS2_PROFILE");
         const char *profile_from = std::getenv("PS2_PROFILE_FROM");
diff --git a/runtime/include/ps2/system.hpp b/runtime/include/ps2/system.hpp
index ac2dd69..2230630 100644
--- a/runtime/include/ps2/system.hpp
+++ b/runtime/include/ps2/system.hpp
@@ -59,6 +59,11 @@ struct Options {
     std::function<void()> on_memcard_saved;
     std::string save_state_path;
     std::uint64_t save_state_frame = 0;
+    // --rounds: every round_frames frames the run loads round_state again.
+    // Presses and max_frames then count frames since the start of the run,
+    // which a loaded state does not set back.
+    std::uint64_t round_frames = 0;
+    std::string round_state;
 };
 
 extern Options g_options;
diff --git a/runtime/src/system.cpp b/runtime/src/system.cpp
index c47ad2d..88a43f6 100644
--- a/runtime/src/system.cpp
+++ b/runtime/src/system.cpp
@@ -56,6 +56,12 @@ std::vector<Event> g_events;
 bool g_halted = false;
 std::string g_halt_reason;
 std::uint64_t g_frames = 0;
+// Frames since the start of the run, for --rounds (a loaded state sets
+// g_frames back): its press times and frame limit count these.
+std::uint64_t g_run_frames = 0, g_round_start = 0;
+bool g_run_started = false;
+
+std::uint64_t script_frame() { return g_options.round_frames ? g_run_frames : g_frames; }
 std::uint64_t g_iop_synced = 0;
 bool g_state_request = false;
 bool g_resumed = false;
@@ -98,7 +104,7 @@ void dump_frame() {
     std::uint32_t w = 0, h = 0;
     if (!gs::display(rgba, w, h)) return;
     char name[512];
-    std::snprintf(name, sizeof name, "%s/frame_%05llu.ppm", g_options.frames_dir.c_str(), static_cast<unsigned long long>(g_frames));
+    std::snprintf(name, sizeof name, "%s/frame_%05llu.ppm", g_options.frames_dir.c_str(), static_cast<unsigned long long>(script_frame()));
     std::FILE *f = std::fopen(name, "wb");
     if (!f) return;
     std::fprintf(f, "P6\n%u %u\n255\n", w, h);
@@ -113,11 +119,12 @@ void apply_presses() {
     // Once the last press is over the pad is left alone, so the web page's live input works after a scripted start.
     std::uint64_t last = 0;
     for (const Press &p : g_options.presses) last = std::max<std::uint64_t>(last, p.frame + p.frames);
-    if (!g_options.presses.empty() && g_frames <= last) {
+    const std::uint64_t now = script_frame();
+    if (!g_options.presses.empty() && now <= last) {
         std::uint16_t mask = 0;
         std::uint8_t stick = 0;
         for (const Press &p : g_options.presses)
-            if (g_frames >= p.frame && g_frames < p.frame + p.frames) {
+            if (now >= p.frame && now < p.frame + p.frames) {
                 mask |= p.buttons;
                 stick |= p.stick;
             }
@@ -174,18 +181,29 @@ void apply_patches(bool boot) {
 
 void vblank() {
     ++g_frames;
+    if (g_options.round_frames) {
+        // The run's clock starts at the first state's frame, so presses for
+        // the first round read as they would without rounds.
+        if (!g_run_started) g_run_started = true, g_run_frames = g_round_start = g_frames;
+        else ++g_run_frames;
+        if (g_run_frames - g_round_start >= g_options.round_frames) {
+            g_round_start = g_run_frames;
+            std::fprintf(stderr, "[rounds] frame %llu: loading %s again\n", static_cast<unsigned long long>(g_run_frames), g_options.round_state.c_str());
+            request_state_operation(true, g_options.round_state.c_str(), nullptr);
+        }
+    }
     time_frames();
     apply_presses();
     apply_patches(false);
     if (g_options.on_vblank) g_options.on_vblank();
     iop::sio2::flush_cards();
     if (g_options.trace_iop_modules && g_frames % 25 == 0) std::fprintf(stderr, "[frame] %llu prims %llu\n", static_cast<unsigned long long>(g_frames), static_cast<unsigned long long>(gs::primitives_drawn()));
-    if (!g_options.frames_dir.empty() && g_options.frame_every && g_frames % g_options.frame_every == 0) dump_frame();
+    if (!g_options.frames_dir.empty() && g_options.frame_every && script_frame() % g_options.frame_every == 0) dump_frame();
     hw::vblank_start();
     iop::vblank(true);
     schedule(hw::kEventVblankEnd + 100, now() + hblank_cycles() * 22u, [] { iop::vblank(false); });
     kernel::on_vblank_start();
-    if (g_options.max_frames && g_frames >= g_options.max_frames) halt("frame limit reached");
+    if (g_options.max_frames && script_frame() >= g_options.max_frames) halt("frame limit reached");
     if (g_options.save_state_frame && g_frames == g_options.save_state_frame) g_state_request = true;
     schedule(hw::kEventVblank, now() + frame_cycles(), vblank);
 }
-- 
