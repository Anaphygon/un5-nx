+        ends[v[2]] = max(ends.get(v[2], v[2]), v[2] + v[5])
+    # The window starts where the segment does, not at the unit below it:
+    # UN5's second level overlays start at 0x8F3D00, where BTL ends, and
+    # rounding both down would make the windows overlap.
+    return [(vaddr, max(UNIT, (end - vaddr + 3) & ~3)) for vaddr, end in sorted(ends.items())]
 
 
-def extent(dump, base, cap=0x40000):
-    # The ELF only says the window begins here; what the game unpacks decides
-    # how far it reaches, so the image covers the units it wrote, stopping at
-    # the first entirely empty one.
-    size = 0
-    while size < cap and size + UNIT <= len(dump) - base:
-        if dump[base + size:base + size + UNIT] == b'\0' * UNIT:
+def extent(dump, base, cap):
+    # What the game unpacks decides how far an image reaches: the window up to
+    # its last unit holding anything. An overlay can have an all-zero unit in
+    # its middle, so only the empty tail is cut.
+    size = min(cap, max(0, len(dump) - base)) & ~3
+    while size > 0:
+        tail = size - (size - 1) % UNIT - 1
+        if dump[base + tail:base + size] != b'\0' * (size - tail):
             break
-        size += UNIT
-    return size or UNIT
