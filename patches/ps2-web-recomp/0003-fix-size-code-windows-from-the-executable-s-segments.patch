+++ b/tests/windows_segments.py
@@ -0,0 +1,47 @@
+#!/usr/bin/env python3
+"""Size code windows from the executable's segments, not one 16 KiB unit.
+
+Naruto Shippuden Ultimate Ninja 5 loads three overlays of different sizes at
+one address and two more right after the first, each an empty executable
+segment. A window must start where its segments do and reach as far as the
+largest of them, and a capture must keep an all-zero unit in the middle of an
+image.
+"""
+from pathlib import Path
+import importlib.util
+import struct
+
+root = Path(__file__).resolve().parents[1]
+spec = importlib.util.spec_from_file_location('windows', root / 'scripts/windows.py')
+windows = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(windows)
+
+
+def elf(segments):
+    data = bytearray(52 + 32 * len(segments))
+    data[:7] = b'\x7fELF\x01\x01\x01'
+    struct.pack_into('<HHIIIIIHHHHHH', data, 16, 2, 8, 1, 0x100000, 52, 0, 0, 52, 32, len(segments), 40, 0, 0)
+    for i, (vaddr, filesz, memsz) in enumerate(segments):
+        struct.pack_into('<8I', data, 52 + 32 * i, 1, 0, vaddr, vaddr, filesz, memsz, 7, 16)
+    return bytes(data)
+
+
+image = elf([
+    (0x100000, 0x5000, 0x5000),  # the program itself has contents: no window
+    (0x106d00, 0, 0x22d000),
+    (0x106d00, 0, 0x1f4b00),
+    (0x106d00, 0, 0x29f00),
+    (0x333d00, 0, 0x30d00),
+    (0x333d00, 0, 0x34c00),
+])
+wins = windows.windows(image)
+assert wins == [(0x106d00, 0x22d000), (0x333d00, 0x34c00)], [(hex(b), hex(s)) for b, s in wins]
+
+dump = bytearray(0x380000)
+dump[0x106d00:0x106d04] = b'\x08\x00\xe0\x03'
+dump[0x106d00 + 0x9000:0x106d00 + 0x9004] = b'\x08\x00\xe0\x03'  # past an empty unit
+# The image ends with the last unit holding anything, the empty one before it kept.
+size = windows.extent(bytes(dump), 0x106d00, 0x22d000)
+assert size == 3 * windows.UNIT, hex(size)
+assert windows.extent(bytes(dump), 0x333d00, 0x34c00) == windows.UNIT
+print('Code window segment regression passed')
