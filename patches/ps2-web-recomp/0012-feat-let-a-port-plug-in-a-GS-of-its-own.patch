 #include "ps2/state.hpp"
 
 #include <algorithm>
@@ -436,6 +437,10 @@ void init() {
     if (built) return;
     build_tables();
     built = true;
+    if (const ExternalGs *external = external_gs()) {
+        if (!external->open()) std::fprintf(stderr, "[gs] the external GS did not open\n");
+        return;
+    }
 #ifdef PS2_GPU
     const char *backend = std::getenv("PS2_GS");
     const gpu::Mode wanted = !backend || std::strcmp(backend, "gpu") == 0 ? gpu::Mode::primary : std::strcmp(backend, "both") == 0 ? gpu::Mode::mirror : gpu::Mode::off;
@@ -732,6 +737,10 @@ void note_transfer(std::uint32_t reg, std::uint64_t value) {
 }
 
 void render_read_image(std::uint8_t *data, std::uint32_t qwords) {
+    if (const ExternalGs *external = external_gs()) {
+        external->read_fifo(data, qwords);
+        return;
+    }
     const std::size_t bytes = static_cast<std::size_t>(qwords) * 16;
     std::memset(data, 0, bytes);
     if (!g_transfer.active || (g_state.trxdir & 3u) != 1) return;
@@ -821,6 +830,11 @@ void write_privileged(std::uint32_t address, std::uint64_t value) {
     case 0x1080: g_siglblid = value; break;
     default: break;
     }
+    // The CPU thread writes while the render thread reads, as on a PS2.
+    if (const ExternalGs *external = external_gs()) {
+        if ((address & 0x1FF0u) == 0x1000) external->write_csr(static_cast<std::uint32_t>(value));
+        else std::memcpy(external->privileged() + (address & 0x1FF8u), &value, sizeof value);
+    }
 }
 
