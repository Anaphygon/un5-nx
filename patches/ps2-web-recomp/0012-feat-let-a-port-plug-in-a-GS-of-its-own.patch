@@ -240,6 +241,10 @@ void render_reset() {
 }
 
 void render(int path, const std::uint8_t *data, std::uint32_t qwc) {
+    if (const ExternalGs *external = external_gs()) {
+        external->transfer(path, data, qwc);
+        return;
+    }
     GsSink sink{path};
     walk(g_paths[path], data, qwc, sink);
 }
