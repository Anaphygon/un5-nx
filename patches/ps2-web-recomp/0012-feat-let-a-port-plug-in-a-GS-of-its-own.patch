+    }
 #ifdef PS2_GPU
     if (!gpu::has_surface()) return false;
     const int circuit = (r.pmode & 2u) ? 1 : (r.pmode & 1u) ? 0 : -1;
@@ -1005,6 +1023,11 @@ Rendered render_pending(const std::function<void(const DisplayRegs &)> &on_prese
 #endif
             break;
         case queue::kPresent: {
