+                break;
+            }
             DisplayRegs regs;
             std::memcpy(&regs, payload, sizeof regs);
             on_present(regs);
@@ -1163,3 +1186,14 @@ void state(ps2::state::Stream &s) {
 }
 
 }
+
+namespace ps2 {
+
+namespace {
+const ExternalGs *g_external = nullptr;
+}
+
+void set_external_gs(const ExternalGs *gs) { g_external = gs; }
+const ExternalGs *external_gs() { return g_external; }
+
+}
