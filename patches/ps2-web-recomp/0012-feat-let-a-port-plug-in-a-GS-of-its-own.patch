diff --git a/runtime/include/ps2/external_gs.hpp b/runtime/include/ps2/external_gs.hpp
new file mode 100644
index 0000000..9ef7dc4
--- /dev/null
+++ b/runtime/include/ps2/external_gs.hpp
@@ -0,0 +1,27 @@
+#pragma once
+
+#include <cstdint>
+
+namespace ps2 {
+
+// A GS outside the runtime, such as a hardware renderer a port links in. Once
+// set (before the window opens), the runtime's own GS steps aside: GIF packets
+// go to transfer() raw, privileged register writes land in `privileged` too,
+// each presented field calls vsync(), and the GS draws to the screen itself.
+// Every call but set_external_gs comes from the render thread.
+struct ExternalGs {
+    bool (*open)();
+    // path 1 (XGKICK), 2 (VIF1 DIRECT) or 3 (GIF DMA), in quadwords.
+    void (*transfer)(int path, const void *data, std::uint32_t qwc);
+    // 8 KiB laid out as the GS registers at 0x12000000.
+    std::uint8_t *(*privileged)();
+    void (*write_csr)(std::uint32_t csr);
+    void (*vsync)(std::uint32_t field);
+    // A GS-to-host image transfer (TRXDIR = 1).
+    void (*read_fifo)(void *data, std::uint32_t qwc);
+};
+
+void set_external_gs(const ExternalGs *gs);
+const ExternalGs *external_gs();
+
+}
