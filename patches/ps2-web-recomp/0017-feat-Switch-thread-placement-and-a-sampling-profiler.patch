--- /dev/null
+++ b/host/switch_threads.hpp
@@ -0,0 +1,7 @@
+#pragma once
+
+// Switch only: see switch_threads.cpp.
+// Moves the calling thread to `core` (0-2 are the application's).
+void switch_pin_current_thread(int core);
+// Threads created from now on start on `core`; -1 restores libnx's default.
+void switch_new_thread_core(int core);
