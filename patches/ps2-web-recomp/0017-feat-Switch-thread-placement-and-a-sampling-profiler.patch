diff --git a/host/switch_threads.cpp b/host/switch_threads.cpp
new file mode 100644
index 0000000..9471ab0
--- /dev/null
+++ b/host/switch_threads.cpp
@@ -0,0 +1,41 @@
+// Thread placement on the Switch. libnx starts every thread on the process's
+// default core, and Horizon does not time-slice threads of the same
+// priority, so without this the runner's threads queue up on one core.
+#ifdef __SWITCH__
+#include "switch_threads.hpp"
+
+#include <switch.h>
+
+#include <atomic>
+#include <cstdint>
+
+void switch_sampler_add_thread(Handle handle, std::uintptr_t entry);
+
+namespace {
+std::atomic<int> g_new_thread_core{-1};
+}
+
+void switch_pin_current_thread(int core) {
+    svcSetThreadCoreMask(CUR_THREAD_HANDLE, core, 1u << core);
+}
+
+void switch_new_thread_core(int core) { g_new_thread_core.store(core); }
+
+// Every thread libnx creates passes through here (pthreads, C11 threads and
+// std::thread included): -Wl,--wrap=threadCreate.
+extern "C" Result __real_threadCreate(Thread *t, ThreadFunc entry, void *arg, void *stack_mem, size_t stack_sz, int prio,
+                                      int cpuid);
+extern "C" Result __wrap_threadCreate(Thread *t, ThreadFunc entry, void *arg, void *stack_mem, size_t stack_sz, int prio,
+                                      int cpuid) {
+    const int core = g_new_thread_core.load();
+    const Result rc = __real_threadCreate(t, entry, arg, stack_mem, stack_sz, prio, core >= 0 ? core : cpuid);
+    if (R_SUCCEEDED(rc)) {
+        if (core >= 0) svcSetThreadCoreMask(t->handle, core, 1u << core);
+        switch_sampler_add_thread(t->handle, reinterpret_cast<std::uintptr_t>(entry));
+    }
+    return rc;
+}
+
+// For code outside the runner (a port's GS) that cannot include this header.
+extern "C" void ps2_switch_new_thread_core(int core) { switch_new_thread_core(core); }
+#endif
