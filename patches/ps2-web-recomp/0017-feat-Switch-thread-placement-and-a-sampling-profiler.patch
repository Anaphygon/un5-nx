diff --git a/host/switch_sampler.cpp b/host/switch_sampler.cpp
new file mode 100644
index 0000000..72793b0
--- /dev/null
+++ b/host/switch_sampler.cpp
@@ -0,0 +1,188 @@
+// A sampling profiler for the Switch runner: the Switch has no perf, so a
+// thread of our own pauses every other thread of the process about once a
+// millisecond, reads where it is (PC, LR and a few frame-pointer frames) and
+// lets it go. At exit it prints the hottest stacks per thread as absolute
+// addresses (subtract the NRO's load address, from a known symbol, for
+// addr2line against ps2run.elf) and each thread's core.
+//
+// PS2_SAMPLE=<seconds> in args.txt starts it that many seconds in.
+#ifdef __SWITCH__
+#include "switch_sampler.hpp"
+
+#include <switch.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <vector>
+
+
+namespace {
+
+constexpr int kMaxThreads = 24;
+constexpr int kFrames = 6;
+constexpr std::size_t kTable = 1u << 14;
+
+struct Known {
+    Handle handle = INVALID_HANDLE;
+    std::uintptr_t entry = 0;  // what the thread runs, for its name
+    std::uintptr_t stack_lo = 0, stack_hi = 0;
+    std::uint64_t samples = 0;
+    bool dead = false;
+};
+
+struct Slot {
+    std::uint32_t thread;  // index + 1, 0 = empty
+    std::uint32_t count;
+    std::uintptr_t frames[kFrames];
+};
+
+std::mutex g_lock;
+Known g_threads[kMaxThreads];
+int g_count = 0;
+Slot g_table[kTable];
+std::uint64_t g_dropped = 0;
+Thread g_sampler;
+bool g_running = false;
+std::atomic<bool> g_stop{false};
+
+void add_thread(Handle h, std::uintptr_t entry) {
+    if (!std::getenv("PS2_SAMPLE")) return;
+    std::lock_guard<std::mutex> lock(g_lock);
+    if (g_count < kMaxThreads) g_threads[g_count++] = Known{h, entry};
+}
+
+
+// The mapping that holds sp: frame records outside it are not followed.
+void find_stack(Known &t, std::uintptr_t sp) {
+    MemoryInfo info{};
+    u32 page = 0;
+    if (R_SUCCEEDED(svcQueryMemory(&info, &page, sp))) {
+        t.stack_lo = info.addr;
+        t.stack_hi = info.addr + info.size;
+    }
+}
+
+void record(std::uint32_t thread, const std::uintptr_t (&frames)[kFrames]) {
+    std::uint64_t h = thread;
+    for (std::uintptr_t f : frames) h = (h ^ f) * 0x100000001B3ull;
+    for (std::size_t i = 0, at = h & (kTable - 1); i < 64; ++i, at = (at + 1) & (kTable - 1)) {
+        Slot &s = g_table[at];
+        if (!s.thread) {
+            s.thread = thread;
+            std::copy(std::begin(frames), std::end(frames), s.frames);
+        }
+        if (s.thread == thread && std::equal(std::begin(frames), std::end(frames), s.frames)) {
+            ++s.count;
+            return;
+        }
+    }
+    ++g_dropped;
+}
+
+void sample(int index, Known &t) {
+    if (R_FAILED(svcSetThreadActivity(t.handle, ThreadActivity_Paused))) {
+        t.dead = true;
+        return;
+    }
+    ThreadContext ctx{};
+    const Result rc = svcGetThreadContext3(&ctx, t.handle);
+    std::uintptr_t frames[kFrames] = {};
+    if (R_SUCCEEDED(rc)) {
+        const std::uintptr_t sp = ctx.sp;
+        if (!t.stack_hi || sp < t.stack_lo || sp >= t.stack_hi) find_stack(t, sp);
+        frames[0] = ctx.pc.x;
+        frames[1] = ctx.lr;
+        // Frame records: [fp] = caller's fp, [fp + 8] = return address. The
+        // thread is paused, so its stack holds still while we walk it. The
+        // first record often repeats LR (a non-leaf function), so that one
+        // is skipped.
+        std::uintptr_t fp = ctx.fp;
+        for (int n = 2; n < kFrames && fp >= sp && fp + 16 <= t.stack_hi && !(fp & 7);) {
+            const auto *rec = reinterpret_cast<const std::uintptr_t *>(fp);
+            if (!(n == 2 && rec[1] == frames[1])) frames[n++] = rec[1];
+            if (rec[0] <= fp) break;
+            fp = rec[0];
+        }
+    }
+    svcSetThreadActivity(t.handle, ThreadActivity_Runnable);
+    if (R_FAILED(rc)) return;
+    ++t.samples;
+    record(static_cast<std::uint32_t>(index + 1), frames);
+}
+
+void run(void *arg) {
+    const auto delay_ms = reinterpret_cast<std::uintptr_t>(arg);
+    for (std::uintptr_t waited = 0; waited < delay_ms && !g_stop.load(); waited += 100) svcSleepThread(100'000'000);
+    std::fprintf(stderr, "[sampler] started\n");
+    const Handle self = threadGetCurHandle();
+    while (!g_stop.load()) {
+        int count;
+        {
+            std::lock_guard<std::mutex> lock(g_lock);
+            count = g_count;
+        }
+        for (int i = 0; i < count; ++i)
+            if (!g_threads[i].dead && g_threads[i].handle != self) sample(i, g_threads[i]);
+        svcSleepThread(1'000'000);
+    }
+}
+
+void report() {
+    u64 process_mask = 0;
+    svcGetInfo(&process_mask, InfoType_CoreMask, CUR_PROCESS_HANDLE, 0);
+    std::fprintf(stderr, "[sampler] process core mask %#llx\n", static_cast<unsigned long long>(process_mask));
+    std::fprintf(stderr, "[sampler] start_switch_sampler at %p; %llu dropped\n",
+                 reinterpret_cast<void *>(&start_switch_sampler), static_cast<unsigned long long>(g_dropped));
+    std::vector<const Slot *> slots;
+    for (const Slot &s : g_table)
+        if (s.thread) slots.push_back(&s);
+    std::sort(slots.begin(), slots.end(), [](const Slot *a, const Slot *b) { return a->count > b->count; });
+    for (int i = 0; i < g_count; ++i) {
+        const Known &t = g_threads[i];
+        if (!t.samples) continue;
+        s32 core = -1;
+        u64 mask = 0;
+        svcGetThreadCoreMask(&core, &mask, t.handle);
+        std::fprintf(stderr, "[sampler] thread %d entry %#lx core %d mask %#llx: %llu samples\n", i,
+                     static_cast<unsigned long>(t.entry), static_cast<int>(core), static_cast<unsigned long long>(mask),
+                     static_cast<unsigned long long>(t.samples));
+        int shown = 0;
+        for (const Slot *s : slots) {
+            if (s->thread != static_cast<std::uint32_t>(i + 1)) continue;
+            std::fprintf(stderr, "[sampler]   %5.1f%%", 100.0 * s->count / static_cast<double>(t.samples));
+            for (std::uintptr_t f : s->frames)
+                if (f) std::fprintf(stderr, " %#lx", static_cast<unsigned long>(f));
+            std::fputc('\n', stderr);
+            if (++shown == 40) break;
+        }
+    }
+}
+
+}  // namespace
+
+void switch_sampler_add_thread(Handle handle, std::uintptr_t entry) { add_thread(handle, entry); }
+
+void start_switch_sampler() {
+    const char *delay = std::getenv("PS2_SAMPLE");
+    if (!delay || g_running) return;
+    add_thread(envGetMainThreadHandle(), 0);
+    const auto ms = static_cast<std::uintptr_t>(std::strtoul(delay, nullptr, 10) * 1000);
+    // Above the runner's threads (0x2C), so a sample is taken on time.
+    if (R_FAILED(threadCreate(&g_sampler, run, reinterpret_cast<void *>(ms), nullptr, 0x8000, 0x2A, -2))) return;
+    threadStart(&g_sampler);
+    g_running = true;
+}
+
+void stop_switch_sampler() {
+    if (!g_running) return;
+    g_stop.store(true);
+    threadWaitForExit(&g_sampler);
+    threadClose(&g_sampler);
+    g_running = false;
+    report();
+}
+#endif
