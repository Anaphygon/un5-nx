         ps2::wake_render_thread();
@@ -428,6 +440,9 @@ int run_window(const std::function<int()> &emulate) {
         ps2::stop_vu_thread();
         vu_thread.join();
     }
+#ifdef __SWITCH__
+    stop_switch_sampler();
+#endif
     SDL_Quit();
     std::fflush(nullptr);
     std::_Exit(result);
