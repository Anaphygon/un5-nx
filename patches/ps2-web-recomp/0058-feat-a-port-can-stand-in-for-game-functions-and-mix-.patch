@@ -247,6 +249,21 @@ void probe(Cpu &c, std::uint32_t pc) {
                  c.r[7].w[0], c.r[31].w[0], c.r[2].w[0]);
 }
 
+namespace {
+// Filled by ports' static initialisers, so it lives in a function.
+std::unordered_map<std::uint32_t, HookFn> &hooks() {
+    static std::unordered_map<std::uint32_t, HookFn> map;
+    return map;
+}
+}
+
+void register_hook(std::uint32_t pc, HookFn fn) { hooks()[pc] = fn; }
+
+bool hook(Cpu &c, std::uint32_t pc) {
+    const auto it = hooks().find(pc);
+    return it != hooks().end() && it->second(c);
+}
+
 void breakpoint(Cpu &c, std::uint32_t pc) {
     std::fprintf(stderr, "[ee] break at 0x%08X (ra 0x%08X)\n", pc, c.r[31].w[0]);
