diff --git a/runtime/include/ps2/hook.hpp b/runtime/include/ps2/hook.hpp
new file mode 100644
index 0000000..8fd434b
--- /dev/null
+++ b/runtime/include/ps2/hook.hpp
@@ -0,0 +1,18 @@
+#pragma once
+
+#include "cpu.hpp"
+
+#include <cstdint>
+
+namespace ps2 {
+
+// A host stand-in for a game function. eerecomp --hooks puts the call at the
+// function's entry (only the units that have one include this header, so
+// adding a hook rebuilds those alone). A stand-in returns true when it did
+// the function's work and set c.pc to where the function returns (normally
+// ra, with v0 set); false lets the translated body run.
+using HookFn = bool (*)(Cpu &c);
+void register_hook(std::uint32_t pc, HookFn fn);
+bool hook(Cpu &c, std::uint32_t pc);
+
+}
diff --git a/runtime/include/ps2/system.hpp b/runtime/include/ps2/system.hpp
index 8cc17ff..7d935a5 100644
--- a/runtime/include/ps2/system.hpp
+++ b/runtime/include/ps2/system.hpp
@@ -166,6 +166,10 @@ void set_audio_stretch(bool on);
 void set_port_launcher(PortLauncher launcher);
 PortLauncher port_launcher();
 
+// A port's own sound (a movie it plays natively) mixed into the SPU2's
+// output, 48 kHz stereo, before the sink and any recording take it.
+using AudioMix = void (*)(std::int16_t *stereo, std::size_t frames);
+void set_audio_mix(AudioMix mix);
 void set_audio_sink(std::function<void(const std::int16_t *samples, std::size_t frames)> sink);
 
 }
