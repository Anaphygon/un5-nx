From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 29 Oct 2026 13:38:15 +0700
Subject: [PATCH 21/23] feat: PS2_VU_PROFILE splits the VU thread's time

Every 5 s the VU thread prints how long it was busy and idle, the time spent in compiled VU1 programs (with XGKICK apart) and in VIF unpack, and the twelve programs that took longest with their call counts. Read on first use, since args.txt sets the environment after static init.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 runtime/src/system.cpp   | 14 ++++++++-
 runtime/src/vif.cpp      | 13 ++++++++
 runtime/src/vu_micro.cpp | 64 +++++++++++++++++++++++++++++++++++++++-
 runtime/src/vu_micro.hpp |  5 ++++
 4 files changed, 94 insertions(+), 2 deletions(-)

diff --git a/runtime/src/system.cpp b/runtime/src/system.cpp
index 9db3929..eda27fd 100644
--- a/runtime/src/system.cpp
+++ b/runtime/src/system.cpp
@@ -545,7 +545,19 @@ void run_vu_thread() {
         }
         const auto start = std::chrono::steady_clock::now();
         in.wait_for_work(50);
-        g_vu_idle_ms.store(g_vu_idle_ms.load() + std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count());
+        const double idle = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+        g_vu_idle_ms.store(g_vu_idle_ms.load() + idle);
+        if (vu::profiling()) {
+            static auto since = std::chrono::steady_clock::now();
+            static double idle_since = 0;
+            idle_since += idle;
+            const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - since).count();
+            if (ms >= 5000) {
+                vu::report_profile(ms - idle_since, idle_since, ms / 1000);
+                since = std::chrono::steady_clock::now();
+                idle_since = 0;
+            }
+        }
     }
 }
 void post_present() { gs::post_present(); }
