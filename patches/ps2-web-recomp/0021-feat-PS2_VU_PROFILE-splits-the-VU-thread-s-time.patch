     Unit &u = state(unit);
     const bool dry = shadow(unit);
     if (dry && u.mode != 2) {
diff --git a/runtime/src/vu_micro.cpp b/runtime/src/vu_micro.cpp
index fb1a090..6000376 100644
--- a/runtime/src/vu_micro.cpp
+++ b/runtime/src/vu_micro.cpp
@@ -12,6 +12,10 @@
 #include "ps2/state.hpp"
 
 #include <atomic>
+#include <vector>
+#include <format>
+#include <chrono>
+#include <algorithm>
 #include <cmath>
 #include <cstdio>
 #include <cstdlib>
@@ -710,6 +714,36 @@ void run_fast(int n, std::uint32_t address);
 
 std::unordered_map<std::uint64_t, ProgramFn> g_programs;
 
+// PS2_VU_PROFILE: where the VU thread's time goes, printed every 5 s: time
+// in each compiled VU1 program (by key), in XGKICK and in VIF unpack (the
+// latter added by vif.cpp through add_unpack_time).
+// Read on first use: args.txt sets the environment after static init.
+bool profile_on() {
+    static const bool on = std::getenv("PS2_VU_PROFILE") != nullptr;
+    return on;
+}
+struct ProgramStat {
+    std::uint64_t calls = 0;
+    double ms = 0;
+};
+std::unordered_map<ProgramFn, ProgramStat> g_program_stats;
+double g_kick_ms = 0, g_unpack_ms = 0;
+using Clock = std::chrono::steady_clock;
+
+double ms_since(Clock::time_point t) { return std::chrono::duration<double, std::milli>(Clock::now() - t).count(); }
+
+void run_profiled(ProgramFn fn) {
+    if (!profile_on()) {
+        fn(g_vu1, g_vu1_mem);
+        return;
+    }
+    const auto t = Clock::now();
+    fn(g_vu1, g_vu1_mem);
+    ProgramStat &s = g_program_stats[fn];
+    ++s.calls;
+    s.ms += ms_since(t);
+}
+
 struct Candidate {
     std::vector<std::uint32_t> runs;
     std::vector<std::uint8_t> code;
@@ -775,7 +809,35 @@ void register_programs(const Program *programs, std::uint32_t count) {
 void kick(int unit, std::uint32_t address) {
     if (g_kick_log && unit == 1) g_kick_log->push_back(address);
     Unit u = unit_of(unit);
+    if (!profile_on()) {
+        xgkick(u, address);
+        return;
+    }
+    const auto t = Clock::now();
     xgkick(u, address);
+    g_kick_ms += ms_since(t);
+}
+
+void add_unpack_time(double ms) { g_unpack_ms += ms; }
+bool profiling() { return profile_on(); }
+
+void report_profile(double busy_ms, double idle_ms, double seconds) {
+    std::vector<std::pair<ProgramFn, ProgramStat>> v(g_program_stats.begin(), g_program_stats.end());
+    std::sort(v.begin(), v.end(), [](const auto &a, const auto &b) { return a.second.ms > b.second.ms; });
+    double programs = 0;
+    for (const auto &[fn, s] : v) programs += s.ms;
+    std::string line = std::format("[vu-profile] {:.1f} s: VU thread busy {:.0f} ms, idle {:.0f} ms; VU1 programs {:.0f} ms "
+                                   "(of it XGKICK {:.0f}), VIF unpack {:.0f} ms; top programs:",
+                                   seconds, busy_ms, idle_ms, programs, g_kick_ms, g_unpack_ms);
+    for (std::size_t i = 0; i < v.size() && i < 12; ++i) {
+        std::uint64_t key = 0;
+        for (const auto &[k, f] : g_programs)
+            if (f == v[i].first) key = k;
+        line += std::format(" {:016X} {:.0f}ms/{}", key, v[i].second.ms, v[i].second.calls);
+    }
+    std::fprintf(stderr, "%s\n", line.c_str());
+    g_program_stats.clear();
+    g_kick_ms = g_unpack_ms = 0;
 }
 
 std::uint32_t top() { return g_top; }
@@ -922,7 +984,7 @@ void run_entry(int unit, std::uint32_t pc) {
                 return;
             }
             if (jit && jit != fn && ++sampled % 32 == 0) check_jit(fn, jit);
-            else fn(g_vu1, g_vu1_mem);
+            else run_profiled(fn);
             return;
         }
     }
