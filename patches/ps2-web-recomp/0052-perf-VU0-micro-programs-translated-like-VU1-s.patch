+// VU0 programs translated by vurecomp --vu0, by key, and the one found last
+// at each entry (as for VU1).
+std::unordered_map<std::uint64_t, ProgramFn> g_programs0;
+EntryCache g_entries0[512];
+
+void register_programs0(const Program *programs, std::uint32_t count) {
