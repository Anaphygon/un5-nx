+}
+
 void register_programs(const Program *programs, std::uint32_t count, bool round_to_zero) {
     g_round_to_zero = round_to_zero;
     for (std::uint32_t i = 0; i < count; ++i)
@@ -1020,6 +1030,7 @@ std::uint32_t top() { return g_top; }
 std::uint32_t itop() { return g_itop; }
 
 ProgramFn lookup(std::uint32_t address);
+ProgramFn lookup0(std::uint32_t address);
 
 std::atomic<std::uint64_t> g_interpreted_calls{0};
 
@@ -1173,6 +1184,12 @@ void run_entry(int unit, std::uint32_t pc) {
             return;
         }
     }
+    if (unit == 0 && !interpret_only) {
+        if (const ProgramFn fn = lookup0(pc)) {
+            fn(g_cpu.vu0, g_vu0_mem);
+            return;
+        }
+    }
     if (unit == 1) g_interpreted_calls.fetch_add(1, std::memory_order_relaxed);
     if (count && unit == 1) {
         ++misses[pc];
@@ -1234,6 +1251,43 @@ ProgramFn lookup(std::uint32_t address) {
     return e.function;
 }
 
+// The translated VU0 program starting at this address, if there is one; with
+// PS2_VU_RECORD=<dir>, the code of one that is not goes to <dir>/vu0.
+ProgramFn lookup0(std::uint32_t address) {
+    EntryCache &e = g_entries0[(address & 4095u) >> 3];
+    if (e.generation == g_generation[0]) return e.function;
+    e.generation = g_generation[0];
+    for (const Candidate &c : e.candidates)
+        if (candidate_matches(c, g_vu0_code)) {
+            e.function = c.function;
+            e.key = c.key;
+            return e.function;
+        }
+    const std::vector<std::uint32_t> pcs = reachable(g_vu0_code, 4095u, address);
+    const std::uint64_t key = program_key(g_vu0_code, pcs, address & 4095u);
+    e.key = key;
+    const auto it = g_programs0.find(key);
+    e.function = it == g_programs0.end() ? nullptr : it->second;
+    Candidate c = make_candidate(pcs, g_vu0_code);
+    c.key = key;
+    c.function = e.function;
+    if (e.candidates.size() < 8) e.candidates.push_back(std::move(c));
+    else e.candidates[e.next++ % 8] = std::move(c);
+    static const char *record = std::getenv("PS2_VU_RECORD");
+    if (!e.function && record) {
+        char name[64];
+        std::snprintf(name, sizeof name, "%016llX_%04X.bin", static_cast<unsigned long long>(key), address & 4095u);
+        static std::unordered_set<std::string> recorded;
+        if (!recorded.insert(name).second) return e.function;
+        const std::filesystem::path dir = std::filesystem::path(record) / "vu0";
+        if (!std::filesystem::exists(dir / name)) {
+            std::filesystem::create_directories(dir);
+            std::ofstream(dir / name, std::ios::binary).write(reinterpret_cast<const char *>(g_vu0_code), 4096);
+        }
+    }
+    return e.function;
+}
+
 void run_fast(int n, std::uint32_t address) {
     Unit u = unit_of(n);
     Vu0Regs &r = *u.regs;
@@ -1377,6 +1431,7 @@ void vcallms(Cpu &, std::uint32_t address) { vu::run(0, address); }
 }
 
 __attribute__((weak)) void register_generated_vu() {}
+__attribute__((weak)) void register_generated_vu0() {}
 
