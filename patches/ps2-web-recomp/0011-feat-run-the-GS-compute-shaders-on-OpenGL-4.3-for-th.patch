diff --git a/runtime/src/gs/gpu/gl_device.inc b/runtime/src/gs/gpu/gl_device.inc
new file mode 100644
index 0000000..3c30482
--- /dev/null
+++ b/runtime/src/gs/gpu/gl_device.inc
@@ -0,0 +1,241 @@
+// OpenGL 4.3 device for the GS compute shaders, for platforms without WebGPU
+// (the Switch, through mesa). Included by gpu.cpp inside its anonymous
+// namespace in place of the WebGPU device code; the shaders are gs.wgsl
+// translated by scripts/glsl.sh, one program per entry point.
+
+#define PS2_GL_FUNCTIONS(X)                                         \
+    X(PFNGLGETSTRINGPROC, glGetString)                              \
+    X(PFNGLGETINTEGERVPROC, glGetIntegerv)                          \
+    X(PFNGLGETERRORPROC, glGetError)                                \
+    X(PFNGLGENBUFFERSPROC, glGenBuffers)                            \
+    X(PFNGLDELETEBUFFERSPROC, glDeleteBuffers)                      \
+    X(PFNGLBINDBUFFERPROC, glBindBuffer)                            \
+    X(PFNGLBUFFERDATAPROC, glBufferData)                            \
+    X(PFNGLBUFFERSUBDATAPROC, glBufferSubData)                      \
+    X(PFNGLGETBUFFERSUBDATAPROC, glGetBufferSubData)                \
+    X(PFNGLCLEARBUFFERDATAPROC, glClearBufferData)                  \
+    X(PFNGLBINDBUFFERBASEPROC, glBindBufferBase)                    \
+    X(PFNGLBINDBUFFERRANGEPROC, glBindBufferRange)                  \
+    X(PFNGLCREATESHADERPROC, glCreateShader)                        \
+    X(PFNGLSHADERSOURCEPROC, glShaderSource)                        \
+    X(PFNGLCOMPILESHADERPROC, glCompileShader)                      \
+    X(PFNGLGETSHADERIVPROC, glGetShaderiv)                          \
+    X(PFNGLGETSHADERINFOLOGPROC, glGetShaderInfoLog)                \
+    X(PFNGLDELETESHADERPROC, glDeleteShader)                        \
+    X(PFNGLCREATEPROGRAMPROC, glCreateProgram)                      \
+    X(PFNGLATTACHSHADERPROC, glAttachShader)                        \
+    X(PFNGLLINKPROGRAMPROC, glLinkProgram)                          \
+    X(PFNGLGETPROGRAMIVPROC, glGetProgramiv)                        \
+    X(PFNGLGETPROGRAMINFOLOGPROC, glGetProgramInfoLog)              \
+    X(PFNGLUSEPROGRAMPROC, glUseProgram)                            \
+    X(PFNGLDISPATCHCOMPUTEPROC, glDispatchCompute)                  \
+    X(PFNGLMEMORYBARRIERPROC, glMemoryBarrier)                      \
+    X(PFNGLFINISHPROC, glFinish)                                    \
+    X(PFNGLFLUSHPROC, glFlush)                                      \
+    X(PFNGLGENQUERIESPROC, glGenQueries)                            \
+    X(PFNGLBEGINQUERYPROC, glBeginQuery)                            \
+    X(PFNGLENDQUERYPROC, glEndQuery)                                \
+    X(PFNGLGETQUERYOBJECTIVPROC, glGetQueryObjectiv)                \
+    X(PFNGLGETQUERYOBJECTUI64VPROC, glGetQueryObjectui64v)
+
+#define PS2_GL_DECLARE(type, name) type name = nullptr;
+PS2_GL_FUNCTIONS(PS2_GL_DECLARE)
+#undef PS2_GL_DECLARE
+
+EGLDisplay g_egl_display = EGL_NO_DISPLAY;
+EGLContext g_egl_context = EGL_NO_CONTEXT;
+GLuint g_programs[kPipelines] = {};
+
+// GPU time per submit, from a ring of GL_TIME_ELAPSED queries read once their
+// results are in, as WebGPU's timestamp queries feed busy_ms().
+constexpr int kTimers = 8;
+GLuint g_timers[kTimers] = {};
+bool g_timer_busy[kTimers] = {};
+int g_timer_next = 0;
+
+void collect_timers() {
+    for (int i = 0; i < kTimers; ++i) {
+        if (!g_timer_busy[i]) continue;
+        GLint ready = 0;
+        glGetQueryObjectiv(g_timers[i], GL_QUERY_RESULT_AVAILABLE, &ready);
+        if (!ready) continue;
+        GLuint64 ns = 0;
+        glGetQueryObjectui64v(g_timers[i], GL_QUERY_RESULT, &ns);
+        g_measured_ns += ns;
+        ++g_measured;
+        g_timer_busy[i] = false;
+    }
+}
+
+// The window (SDL) keeps its own context current on the render thread. Every
+// stretch of GL work runs under ours and hands SDL's back afterwards.
+struct Current {
+    EGLDisplay display = eglGetCurrentDisplay();
+    EGLSurface draw = eglGetCurrentSurface(EGL_DRAW), read = eglGetCurrentSurface(EGL_READ);
+    EGLContext context = eglGetCurrentContext();
+    Current() {
+        if (context != g_egl_context) eglMakeCurrent(g_egl_display, EGL_NO_SURFACE, EGL_NO_SURFACE, g_egl_context);
+    }
+    ~Current() {
+        if (context == g_egl_context) return;
+        if (context == EGL_NO_CONTEXT) eglMakeCurrent(g_egl_display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+        else eglMakeCurrent(display, draw, read, context);
+    }
+};
+
+// WebGPU hands out zeroed buffers and the shaders rely on it.
+Buffer make_buffer(std::uint64_t size) {
+    Current gl;
+    GLuint b = 0;
+    glGenBuffers(1, &b);
+    glBindBuffer(GL_COPY_WRITE_BUFFER, b);
+    glBufferData(GL_COPY_WRITE_BUFFER, static_cast<GLsizeiptr>(size), nullptr, GL_DYNAMIC_COPY);
+    glClearBufferData(GL_COPY_WRITE_BUFFER, GL_R32UI, GL_RED_INTEGER, GL_UNSIGNED_INT, nullptr);
+    return b;
+}
+
+void release_buffer(Buffer &b) {
+    if (!b) return;
+    Current gl;
+    glDeleteBuffers(1, &b);
+    b = 0;
+}
+
+void write_buffer(Buffer b, std::uint64_t offset, const void *data, std::uint64_t size) {
+    if (!size) return;
+    Current gl;
+    glBindBuffer(GL_COPY_WRITE_BUFFER, b);
+    glBufferSubData(GL_COPY_WRITE_BUFFER, static_cast<GLintptr>(offset), static_cast<GLsizeiptr>(size), data);
+}
+
+void ensure_capacity() {
+    const std::uint64_t data_bytes = std::max<std::uint64_t>(g_arena.size() * 4, 16);
+    if (data_bytes > g_data_size) {
+        release_buffer(g_data);
+        g_data_size = std::max<std::uint64_t>(g_data_size * 2, (data_bytes + (4u << 20) - 1) & ~((4ull << 20) - 1));
+        g_data = make_buffer(g_data_size);
+    }
+    const std::uint64_t param_bytes = std::max<std::uint64_t>(g_param_records.size(), 1) * kParamStride;
+    if (param_bytes > g_params_size) {
+        release_buffer(g_params);
+        g_params_size = std::max<std::uint64_t>(g_params_size * 2, std::max<std::uint64_t>(param_bytes, 64 * 1024));
+        g_params = make_buffer(g_params_size);
+    }
+}
+
+// Binding 2 (the parameters) is bound per dispatch, at the command's record.
+void bind_buffers() {
+    const Buffer storage[8] = {g_vram, g_tables, 0, g_data, g_clut, g_scratch, g_cache, g_decoded};
+    for (GLuint i = 0; i < 8; ++i)
+        if (storage[i]) glBindBufferBase(GL_SHADER_STORAGE_BUFFER, i, storage[i]);
+}
+
+// Unlike a WebGPU compute pass, GL orders nothing between dispatches: each
+// one waits for the storage writes of the one before it. There is no surface
+// to present to, so the view WebGPU's submit takes is always null here.
+void submit(const void *) {
+    if (g_commands.empty()) return;
+    Current gl;
+    ensure_capacity();
+    write_buffer(g_data, 0, g_arena.data(), g_arena.size() * 4);
+    write_buffer(g_params, 0, g_param_records.data(), g_param_records.size() * kParamStride);
+    bind_buffers();
+    collect_timers();
+    const int timer = g_timer_next;
+    const bool measure = g_timers[0] && !g_timer_busy[timer];
+    if (measure) {
+        glBeginQuery(GL_TIME_ELAPSED, g_timers[timer]);
+        g_timer_busy[timer] = true;
+        g_timer_next = (timer + 1) % kTimers;
+    }
+    Pipeline current = kPipelines;
+    ++g_submits;
+    ++g_total_passes;
+    for (const Command &c : g_commands) {
+        ++g_dispatches[c.pipeline];
+        if (c.pipeline != current) {
+            glUseProgram(g_programs[c.pipeline]);
+            current = c.pipeline;
+        }
+        glBindBufferRange(GL_UNIFORM_BUFFER, 2, g_params, static_cast<GLintptr>(c.param) * kParamStride, kParamStride);
+        glDispatchCompute(c.x, c.y, 1);
+        glMemoryBarrier(GL_SHADER_STORAGE_BARRIER_BIT);
+    }
+    if (measure) glEndQuery(GL_TIME_ELAPSED);
+    glMemoryBarrier(GL_BUFFER_UPDATE_BARRIER_BIT);
+    glFlush();
+    g_commands.clear();
+    g_command_info.clear();
+    ++g_serial;
+    g_param_records.clear();
+    g_arena.clear();
+    g_decoded_used = 0;
+    g_clut_loads = 0;
+}
+
+void read_back(Buffer source, std::uint64_t bytes, void *out, std::uint64_t offset = 0) {
+    Current gl;
+    glMemoryBarrier(GL_BUFFER_UPDATE_BARRIER_BIT);
+    glBindBuffer(GL_COPY_READ_BUFFER, source);
+    glGetBufferSubData(GL_COPY_READ_BUFFER, static_cast<GLintptr>(offset), static_cast<GLsizeiptr>(bytes), out);
+}
+
+bool compile_programs() {
+    for (int i = 0; i < kPipelines; ++i) {
+        // naga bakes the WGSL override SCALE in as a constant of 1.
+        std::string source = kGlslShaders[i];
+        const std::string one = "const uint SCALE = 1u;";
+        if (const auto at = source.find(one); at != std::string::npos) source.replace(at, one.size(), "const uint SCALE = " + std::to_string(g_scale) + "u;");
+        const char *text = source.c_str();
+        const GLuint shader = glCreateShader(GL_COMPUTE_SHADER);
+        glShaderSource(shader, 1, &text, nullptr);
+        glCompileShader(shader);
+        GLint ok = 0;
+        glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+        if (!ok) {
+            char log[1024] = {};
+            glGetShaderInfoLog(shader, sizeof log, nullptr, log);
+            std::fprintf(stderr, "[gpu] %s: %s\n", kEntryPoints[i], log);
+            return false;
+        }
+        g_programs[i] = glCreateProgram();
+        glAttachShader(g_programs[i], shader);
+        glLinkProgram(g_programs[i]);
+        glDeleteShader(shader);
+        glGetProgramiv(g_programs[i], GL_LINK_STATUS, &ok);
+        if (!ok) {
+            char log[1024] = {};
+            glGetProgramInfoLog(g_programs[i], sizeof log, nullptr, log);
+            std::fprintf(stderr, "[gpu] %s: %s\n", kEntryPoints[i], log);
+            return false;
+        }
+    }
+    return true;
+}
+
+// A context of its own with no surface: the window keeps presenting through
+// SDL, from what display() reads back.
+bool create_context() {
+    g_egl_display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    if (g_egl_display == EGL_NO_DISPLAY || !eglInitialize(g_egl_display, nullptr, nullptr) || !eglBindAPI(EGL_OPENGL_API)) return false;
+    const EGLint config_attributes[] = {EGL_RENDERABLE_TYPE, EGL_OPENGL_BIT, EGL_NONE};
+    EGLConfig config;
+    EGLint configs = 0;
+    if (!eglChooseConfig(g_egl_display, config_attributes, &config, 1, &configs) || !configs) return false;
+    const EGLint context_attributes[] = {EGL_CONTEXT_OPENGL_PROFILE_MASK_KHR, EGL_CONTEXT_OPENGL_CORE_PROFILE_BIT_KHR, EGL_CONTEXT_MAJOR_VERSION_KHR, 4,
+                                         EGL_CONTEXT_MINOR_VERSION_KHR, 3, EGL_NONE};
+    g_egl_context = eglCreateContext(g_egl_display, config, EGL_NO_CONTEXT, context_attributes);
+    if (g_egl_context == EGL_NO_CONTEXT) return false;
+    Current gl;
+#define PS2_GL_LOAD(type, name)                                    \
+    name = reinterpret_cast<type>(eglGetProcAddress(#name));       \
+    if (!name) {                                                   \
+        std::fprintf(stderr, "[gpu] no %s\n", #name);              \
+        return false;                                              \
+    }
+    PS2_GL_FUNCTIONS(PS2_GL_LOAD)
+#undef PS2_GL_LOAD
+    std::fprintf(stderr, "[gpu] %s (%s)\n", reinterpret_cast<const char *>(glGetString(GL_RENDERER)), reinterpret_cast<const char *>(glGetString(GL_VERSION)));
+    glGenQueries(kTimers, g_timers);
+    return true;
+}
diff --git a/runtime/src/gs/gpu/gl_public.inc b/runtime/src/gs/gpu/gl_public.inc
new file mode 100644
index 0000000..a3d81da
--- /dev/null
+++ b/runtime/src/gs/gpu/gl_public.inc
@@ -0,0 +1,66 @@
+// The public half of the OpenGL device (see gl_device.inc), included by gpu.cpp
+// in place of the WebGPU versions of these functions. Reads back synchronously
+// and has no surface: the window presents what display() returns.
+
+bool init(Mode m) {
+    if (m == Mode::off || !create_context()) return false;
+    Current gl;
+    if (const char *scale = std::getenv("PS2_SCALE")) g_scale = std::clamp<std::uint32_t>(static_cast<std::uint32_t>(std::atoi(scale)), 1u, 3u);
+    g_copy_words = (1u << 20) * g_scale * g_scale;
+    g_tiles_per_row = (2048 * static_cast<int>(g_scale) + 15) / 16;
+    g_tile_count.assign(static_cast<std::size_t>(g_tiles_per_row) * g_tiles_per_row, 0);
+    g_tile_fill.assign(static_cast<std::size_t>(g_tiles_per_row) * g_tiles_per_row, 0);
+    g_field_words = (1u << 19) * g_scale * g_scale;
+    g_vram = make_buffer(static_cast<std::uint64_t>(kMemorySize) * g_scale * g_scale);
+    std::vector<std::uint32_t> tables;
+    swizzle_tables(tables);
+    g_tables = make_buffer(tables.size() * 4);
+    write_buffer(g_tables, 0, tables.data(), tables.size() * 4);
+    g_clut = make_buffer(static_cast<std::uint64_t>(kClutSlots) * kClutEntries * 4);
+    g_scratch = make_buffer((static_cast<std::uint64_t>(g_copy_words) + 2ull * g_field_words) * 4);
+    g_cache = make_buffer(static_cast<std::uint64_t>(kCacheWords) * 4);
+    g_decoded = make_buffer(static_cast<std::uint64_t>(kDecodedWords) * 4);
+    if (const char *decode = std::getenv("PS2_DECODE")) g_decode = std::atoi(decode) != 0;
+    g_cache_copy.assign(kCacheWords, 0);
+    if (!compile_programs()) return false;
+    ensure_capacity();
+    g_mode = m;
+    return true;
+}
+
+void wait_idle() {
+    flush_all();
+    submit();
+    Current gl;
+    glFinish();
+}
+
+// The copy WebGPU maps later is taken right away here, so finishing it is
+// only a matter of the serial.
+std::uint32_t g_downloaded_serial = 0;
+
+bool download_async(std::uint8_t *memory, std::uint32_t offset, std::uint32_t bytes, std::uint32_t serial) {
+    download(memory, offset, bytes);
+    g_downloaded_serial = serial;
+    return true;
+}
+
+bool finish_download(std::uint32_t serial) { return serial == g_downloaded_serial; }
+
+bool attach_surface(const SurfaceTarget &) { return false; }
+
+void resize_surface(std::uint32_t, std::uint32_t) {}
+
+bool has_surface() { return false; }
+
+bool present(const DisplaySource &) { return false; }
+
+// Average GPU time of a measured submit times every submit so far, in ms.
+double busy_ms() {
+    if (!g_measured) return 0.0;
+    return static_cast<double>(g_measured_ns) / static_cast<double>(g_measured) * static_cast<double>(g_total_passes) / 1e6;
+}
+
+bool display_async(const DisplaySource &src, std::vector<std::uint32_t> &rgba, std::uint32_t &width, std::uint32_t &height) {
+    return display(src, rgba, width, height);
+}
diff --git a/runtime/src/gs/gpu/glsl/copy_read.comp b/runtime/src/gs/gpu/glsl/copy_read.comp
