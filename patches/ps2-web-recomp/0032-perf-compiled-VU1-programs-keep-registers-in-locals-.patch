-std::string local_vi(std::string o) {
-    std::string declare, sync;
+// Keeps the VU registers a program uses in locals, which the host compiler
+// holds in its own registers, and writes them back where the program leaves
+// (to the interpreter, or at its end). In VU memory the VF registers cost a
+// store and a reload around every instruction, and a lane written alone then
+// read with the others stalls the load until the store is done.
+std::string local_regs(std::string o) {
+    std::string declare, sync, declare_vf;
+    for (int n = 0; n <= 32; ++n) {
+        const std::string reg = n == 32 ? "r.acc" : std::format("r.vf[{}]", n), local = n == 32 ? "facc" : std::format("f{}", n);
+        if (o.find(reg) == std::string::npos) continue;
+        replace_all(o, reg, local);
+        declare_vf += std::format("    Reg128 {} = {};\n", local, reg);
+        if (n) sync += std::format("{} = {}; ", reg, local);
+    }
+    const std::string start = "    fl.start(r);\n";
+    o.insert(o.find(start) + start.size(), declare_vf);
     replace_all(o, "set_vi(r, 0, ", "drop_vi(");
     replace_all(o, "r.vi[0]", "0u");
     for (int n = 1; n < 16; ++n) {
@@ -525,7 +540,7 @@ std::string generate(const Program &p, std::string &name, bool sticky_live) {
     const std::vector<std::uint32_t> pcs = ps2::vu::reachable(p.code.data(), kMask, p.entry);
     std::set<std::uint32_t> in(pcs.begin(), pcs.end());
