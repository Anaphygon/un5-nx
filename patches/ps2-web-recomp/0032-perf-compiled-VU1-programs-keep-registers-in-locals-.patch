@@ -612,7 +627,13 @@ std::string generate(const Program &p, std::string &name, bool sticky_live) {
         const std::uint32_t lo = word(p.code, pc), hi = word(p.code, pc + 4);
         bool out_live = false;
         for (std::int64_t s : successors(pc)) out_live = out_live || s < 0 || !in.count(static_cast<std::uint32_t>(s)) || live_in[static_cast<std::uint32_t>(s)];
-        const Upper u = upper(hi, (any_status && sticky_live) ? true : (any_flags && out_live));
+        const bool exact = any_status && sticky_live;
+        Upper u = upper(hi, exact ? true : (any_flags && out_live));
+        if (!exact && u.post.find("flags(r, ") != std::string::npos) {
+            static const std::regex eager(R"(flags\(r, ([^,]+), (\d+u)\); fl\.set_mac\(r\.mac, r\.status\);)");
+            u.post = std::regex_replace(u.post, eager, "fl.set_lazy(vload($1), $2, r.status);");
