+// The MAC, status and clip flags as the program reads them: each set lands
+// in a ring with its time, and a read sees the newest one old enough.
+// set_lazy keeps the result instead of the flags and works them out only
+// if they are read, which few are. It takes the status before the op from
+// r.status, which the program then no longer updates: its sticky bits miss
+// the ops in between, so vurecomp uses it only in programs that never read
+// a sticky bit. commit brings r.mac and r.status up to date on the way out.
 struct FlagPipe {
     std::uint32_t t = 16;
     std::uint32_t mac_ts[8] = {}, mac_v[8] = {}, status_v[8] = {}, clip_ts[8] = {}, clip_v[8] = {};
+    v4u lazy_v[8];
+    std::uint32_t lazy_d[8] = {};  // 0: mac_v and status_v hold the flags
     unsigned mh = 0, ch = 0;
     std::uint32_t q_value = 0, q_ready = 0;
     bool q_pending = false;
@@ -538,6 +555,28 @@ struct FlagPipe {
         mac_ts[i] = t;
         mac_v[i] = mac;
         status_v[i] = status;
+        lazy_d[i] = 0;
+    }
+    PS2_VU_INLINE void set_lazy(v4u result, unsigned dest, std::uint32_t status_before) {
+        const unsigned i = mh++ & 7u;
+        mac_ts[i] = t;
+        lazy_v[i] = result;
+        lazy_d[i] = dest;
+        status_v[i] = status_before;
+    }
+    PS2_VU_INLINE std::uint32_t mac_at(unsigned i) const { return lazy_d[i] ? mac_of(lazy_v[i], lazy_d[i]) : mac_v[i]; }
+    PS2_VU_INLINE std::uint32_t status_at(unsigned i) const {
+        return lazy_d[i] ? status_of(mac_of(lazy_v[i], lazy_d[i]), status_v[i]) : status_v[i];
+    }
+    // The newest MAC flags, whatever their age (FSSET keeps them).
+    PS2_VU_INLINE std::uint32_t newest_mac(const Vu0Regs &r) const {
+        const unsigned i = (mh - 1) & 7u;
+        return lazy_d[i] ? mac_at(i) : r.mac;
+    }
+    PS2_VU_INLINE void commit(Vu0Regs &r) const {
+        const unsigned i = (mh - 1) & 7u;
+        r.mac = mac_at(i);
+        r.status = (status_at(i) & ~0x30u) | (r.status & 0x30u);
     }
     PS2_VU_INLINE void set_clip(std::uint32_t clip, std::uint32_t at) {
         const unsigned i = ch++ & 7u;
@@ -555,8 +594,8 @@ struct FlagPipe {
         }
         return (mh - 8) & 7u;
     }
-    PS2_VU_INLINE std::uint32_t mac() const { return mac_v[mac_slot()]; }
-    PS2_VU_INLINE std::uint32_t status() const { return status_v[mac_slot()]; }
+    PS2_VU_INLINE std::uint32_t mac() const { return mac_at(mac_slot()); }
+    PS2_VU_INLINE std::uint32_t status() const { return status_at(mac_slot()); }
     PS2_VU_INLINE std::uint32_t clip() const {
         for (unsigned k = 1; k <= 8; ++k) {
             const unsigned i = (ch - k) & 7u;
@@ -587,10 +626,11 @@ PS2_VU_INLINE float u2f(std::uint32_t v) {
     return f;
 }
 
