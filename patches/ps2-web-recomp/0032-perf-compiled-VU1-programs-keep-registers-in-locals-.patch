+    return m[0] | m[1] | m[2] | m[3];
+}
+
+// The status flags after an op that set mac, from the status before it.
+PS2_VU_INLINE std::uint32_t status_of(std::uint32_t mac, std::uint32_t before) {
+    std::uint32_t status = before & 0xFF0u;
     status |= (mac & 0x000Fu) ? 0x1u : 0u;
     status |= (mac & 0x00F0u) ? 0x2u : 0u;
     status |= (mac & 0x0F00u) ? 0x4u : 0u;
     status |= (mac & 0xF000u) ? 0x8u : 0u;
     status |= (status & 0xFu) << 6;
-    r.status = (status & ~0x30u) | (r.status & 0x30u);
+    return (status & ~0x30u) | (before & 0x30u);
+}
+
+PS2_VU_INLINE void flags(Vu0Regs &r, const Reg128 &v, unsigned dest) {
+    r.mac = mac_of(vload(v), dest);
+    r.status = status_of(r.mac, r.status);
 }
 
 PS2_VU_INLINE std::uint32_t clip_value(const Vu0Regs &r, const Reg128 &s, std::uint32_t w) {
@@ -499,9 +507,18 @@ PS2_VU_INLINE void clip(Vu0Regs &r, const Reg128 &s, std::uint32_t w) {
     r.clip = ((r.clip << 6) | f) & 0xFFFFFFu;
