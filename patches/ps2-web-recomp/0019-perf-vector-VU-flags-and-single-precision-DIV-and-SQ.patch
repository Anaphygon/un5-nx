From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 29 Oct 2026 13:14:10 +0700
Subject: [PATCH 19/28] perf: vector VU flags and single-precision DIV and
 SQRT, same results

flags() builds the MAC word from all four lanes at once (identical to the per-lane loop on 50M random inputs). fp::div and fp::sqrt compute in float and step back one unit when an FMA residual shows the correctly rounded result went past the exact one: the truncated exact result, bit for bit what the double path gives (0 mismatches in 800M random cases). Operands with exponents below 64 or of 255 keep the double path. A UN5 battle replay stays byte-identical.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 runtime/include/ps2/fpu.hpp    | 26 ++++++++++++++++++++++++++
 runtime/include/ps2/vu_ops.hpp | 27 ++++++++++++++-------------
 2 files changed, 40 insertions(+), 13 deletions(-)

diff --git a/runtime/include/ps2/fpu.hpp b/runtime/include/ps2/fpu.hpp
index faf3ebe..829af93 100644
--- a/runtime/include/ps2/fpu.hpp
+++ b/runtime/include/ps2/fpu.hpp
@@ -89,18 +89,44 @@ struct Result {
     bool invalid;
 };
 
+// DIV and SQRT are the exact result truncated toward zero. For operands and
+// results well inside the float range that is the single-precision result,
+// which is correctly rounded and so at most one unit past the exact value,
+// stepped back when an FMA residual (exact there) says it went past. That is
+// bit for bit what the double path gives, without converting to double;
+// tiny operands, where the residual could underflow, and the PS2's extra
+// exponent 255 take the double path.
+inline bool fast_range(std::uint32_t x) { return exponent(x) >= 64 && exponent(x) != 255; }
+
 inline Result div(std::uint32_t a, std::uint32_t b) {
     a = flush(a);
     b = flush(b);
     const std::uint32_t sign = (a ^ b) & kSign;
     if (!(b & kAbs)) return {sign | kAbs, true};
     if (!(a & kAbs)) return {sign, false};
+    if (fast_range(a) && fast_range(b)) {
+        const float fa = std::bit_cast<float>(a), fb = std::bit_cast<float>(b);
+        const float q = fa / fb;
+        const std::uint32_t qb = std::bit_cast<std::uint32_t>(q);
+        if (fast_range(qb)) {
+            // past the exact quotient when fa - q * fb, divided by fb, has
+            // the other sign than q
+            const float rem = std::fma(-q, fb, fa);
+            const bool past = rem != 0.0f && (std::signbit(rem) != std::signbit(fb)) != std::signbit(q);
+            return {past ? qb - 1u : qb, false};
+        }
+    }
     return {from_double(to_double(a) / to_double(b)), false};
 }
 
 inline std::uint32_t sqrt(std::uint32_t a) {
     a = flush(a) & kAbs;
     if (!a) return 0;
+    if (fast_range(a)) {
+        const float x = std::bit_cast<float>(a), r = std::sqrt(x);
+        const std::uint32_t rb = std::bit_cast<std::uint32_t>(r);
+        return std::fma(-r, r, x) < 0.0f ? rb - 1u : rb;
+    }
     return from_double(std::sqrt(to_double(a)));
 }
 
diff --git a/runtime/include/ps2/vu_ops.hpp b/runtime/include/ps2/vu_ops.hpp
index cdc93e1..a81564d 100644
--- a/runtime/include/ps2/vu_ops.hpp
+++ b/runtime/include/ps2/vu_ops.hpp
@@ -432,21 +432,22 @@ PS2_VU_INLINE v4u vitof(v4u x, int fraction) {
 }
 
 PS2_VU_INLINE void flags(Vu0Regs &r, const Reg128 &v, unsigned dest) {
-    std::uint32_t mac = 0;
-    for (int i = 0; i < 4; ++i) {
-        if (!(dest & (8u >> i))) continue;
-        const std::uint32_t bit = 3u - static_cast<std::uint32_t>(i);
-        const std::uint32_t x = v.w[i];
-        if (!(x & 0x7F800000u)) mac |= 1u << bit;
-        if (x & 0x80000000u) mac |= 1u << (bit + 4);
-        if ((x & 0x7FFFFFFFu) == 0x7FFFFFFFu) mac |= 1u << (bit + 12);
-    }
+    // All four lanes at once: lane i (x, y, z, w) owns bit 3 - i of the zero,
+    // sign and overflow nibbles; lanes outside dest contribute nothing.
+    const v4u x = vload(v);
+    const v4u lane = {8u, 4u, 2u, 1u};
+    const v4u sel = lane & (v4u)((lane & dest) != 0);
+    const v4u zero = (v4u)((x & 0x7F800000u) == 0) & sel;
+    const v4u sign = (v4u)((x >> 31) != 0) & sel;
+    const v4u over = (v4u)((x & 0x7FFFFFFFu) == 0x7FFFFFFFu) & sel;
+    const v4u m = zero | (sign << 4) | (over << 12);
+    const std::uint32_t mac = m[0] | m[1] | m[2] | m[3];
     r.mac = mac;
     std::uint32_t status = r.status & 0xFF0u;
-    if (mac & 0x000Fu) status |= 0x1u;
-    if (mac & 0x00F0u) status |= 0x2u;
-    if (mac & 0x0F00u) status |= 0x4u;
-    if (mac & 0xF000u) status |= 0x8u;
+    status |= (mac & 0x000Fu) ? 0x1u : 0u;
+    status |= (mac & 0x00F0u) ? 0x2u : 0u;
+    status |= (mac & 0x0F00u) ? 0x4u : 0u;
+    status |= (mac & 0xF000u) ? 0x8u : 0u;
     status |= (status & 0xFu) << 6;
     r.status = (status & ~0x30u) | (r.status & 0x30u);
 }
