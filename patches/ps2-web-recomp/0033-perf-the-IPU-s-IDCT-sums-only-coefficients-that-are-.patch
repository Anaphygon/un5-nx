+// Inline when the FIFO already holds the bits, as it nearly always does.
+inline bool have(std::size_t bits) { return g_in.size() * 8 >= g_bit + bits || fill(bits); }
+
 std::size_t available() { return g_in.size() * 8 > g_bit ? g_in.size() * 8 - g_bit : 0; }
 
-std::uint32_t bits_at(std::size_t bit, unsigned n) {
+// The last bytes of the FIFO, zeros past its end.
+[[gnu::noinline]] std::uint64_t tail_bytes(std::size_t byte) {
+    std::uint8_t b[8] = {};
+    if (byte < g_in.size()) std::memcpy(b, g_in.data() + byte, std::min<std::size_t>(8, g_in.size() - byte));
+    std::uint64_t v;
+    std::memcpy(&v, b, 8);
+    return __builtin_bswap64(v);
+}
+
+inline std::uint32_t bits_at(std::size_t bit, unsigned n) {
     if (!n) return 0;
