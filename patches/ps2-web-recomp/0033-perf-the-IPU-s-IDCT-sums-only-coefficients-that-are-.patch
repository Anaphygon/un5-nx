+// The separable reference IDCT, in doubles. A block has few coefficients
+// that are not zero, so only those are summed: a zero term leaves a sum as it
+// was, and the others are added in the same order as before, so the result
+// does not change by a bit. Each sum runs across x, eight at once, which the
+// compiler vectorizes.
 void idct(const int *in, std::int16_t *out) {
-    const auto &c = tables().cosines;
+    const Tables &t = tables();
     double rows[8][8];
-    for (int v = 0; v < 8; ++v)
-        for (int x = 0; x < 8; ++x) {
-            double s = 0;
-            for (int u = 0; u < 8; ++u) s += c[x][u] * in[v * 8 + u];
-            rows[v][x] = s;
+    int used[8], count = 0;
+    for (int v = 0; v < 8; ++v) {
+        double *row = rows[v];
+        bool any = false;
+        for (int x = 0; x < 8; ++x) row[x] = 0;
+        for (int u = 0; u < 8; ++u) {
+            const int k = in[v * 8 + u];
+            if (!k) continue;
+            any = true;
+            const double d = k;
+            const double *c = t.by_frequency[u];
+            for (int x = 0; x < 8; ++x) row[x] += c[x] * d;
         }
-    for (int y = 0; y < 8; ++y)
-        for (int x = 0; x < 8; ++x) {
-            double s = 0;
-            for (int v = 0; v < 8; ++v) s += c[y][v] * rows[v][x];
-            out[y * 8 + x] = static_cast<std::int16_t>(std::clamp(static_cast<int>(std::floor(s + 0.5)), -256, 255));
+        if (any) used[count++] = v;
+    }
+    for (int y = 0; y < 8; ++y) {
+        double s[8] = {};
+        for (int i = 0; i < count; ++i) {
+            const int v = used[i];
+            const double c = t.cosines[y][v];
+            for (int x = 0; x < 8; ++x) s[x] += c * rows[v][x];
         }
+        for (int x = 0; x < 8; ++x) out[y * 8 + x] = static_cast<std::int16_t>(std::clamp(static_cast<int>(std::floor(s[x] + 0.5)), -256, 255));
+    }
 }
 
