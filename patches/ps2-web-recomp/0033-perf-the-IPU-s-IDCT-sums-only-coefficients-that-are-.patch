-    if (!have(n)) throw NeedData{};
+[[noreturn, gnu::noinline]] void need_data() { throw NeedData{}; }
+
+inline std::uint32_t peek(unsigned n) {
+    if (!have(n)) need_data();
     return bits_at(g_bit, n);
 }
 
-std::uint32_t get(unsigned n) {
+inline std::uint32_t get(unsigned n) {
