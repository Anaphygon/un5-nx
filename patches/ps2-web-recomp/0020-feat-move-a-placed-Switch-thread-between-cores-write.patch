From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 29 Oct 2026 13:14:10 +0700
Subject: [PATCH 20/31] feat: move a placed Switch thread between cores; write
 the sampler report at once

ps2_switch_move_placed_thread() moves the last thread started on a chosen core, so a port can compare cores for a thread it does not own (Mesa's glthread worker) within one run. The sampler builds its report in memory and writes it with one call: line by line to the SD card through unbuffered stderr it took long enough to look like a hang.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 host/switch_sampler.cpp | 33 ++++++++++++++++++++++++++-------
 host/switch_threads.cpp | 14 +++++++++++++-
 2 files changed, 39 insertions(+), 8 deletions(-)

diff --git a/host/switch_sampler.cpp b/host/switch_sampler.cpp
index 72793b0..4d97ba6 100644
--- a/host/switch_sampler.cpp
+++ b/host/switch_sampler.cpp
@@ -14,9 +14,11 @@
 #include <algorithm>
 #include <atomic>
 #include <cstdint>
+#include <cstdarg>
 #include <cstdio>
 #include <cstdlib>
 #include <mutex>
+#include <string>
 #include <vector>
 
 
@@ -131,11 +133,25 @@ void run(void *arg) {
     }
 }
 
+// Writes the report in one go: stderr goes unbuffered to the SD card, where a
+// thousand small writes took long enough to look like a hang.
+std::string g_out;
+
+void out(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+void out(const char *fmt, ...) {
+    char line[256];
+    va_list ap;
+    va_start(ap, fmt);
+    const int n = std::vsnprintf(line, sizeof line, fmt, ap);
+    va_end(ap);
+    if (n > 0) g_out.append(line, std::min<std::size_t>(static_cast<std::size_t>(n), sizeof line - 1));
+}
+
 void report() {
     u64 process_mask = 0;
     svcGetInfo(&process_mask, InfoType_CoreMask, CUR_PROCESS_HANDLE, 0);
-    std::fprintf(stderr, "[sampler] process core mask %#llx\n", static_cast<unsigned long long>(process_mask));
-    std::fprintf(stderr, "[sampler] start_switch_sampler at %p; %llu dropped\n",
+    out("[sampler] process core mask %#llx\n", static_cast<unsigned long long>(process_mask));
+    out("[sampler] start_switch_sampler at %p; %llu dropped\n",
                  reinterpret_cast<void *>(&start_switch_sampler), static_cast<unsigned long long>(g_dropped));
     std::vector<const Slot *> slots;
     for (const Slot &s : g_table)
@@ -147,19 +163,22 @@ void report() {
         s32 core = -1;
         u64 mask = 0;
         svcGetThreadCoreMask(&core, &mask, t.handle);
-        std::fprintf(stderr, "[sampler] thread %d entry %#lx core %d mask %#llx: %llu samples\n", i,
+        out("[sampler] thread %d entry %#lx core %d mask %#llx: %llu samples\n", i,
                      static_cast<unsigned long>(t.entry), static_cast<int>(core), static_cast<unsigned long long>(mask),
                      static_cast<unsigned long long>(t.samples));
         int shown = 0;
         for (const Slot *s : slots) {
             if (s->thread != static_cast<std::uint32_t>(i + 1)) continue;
-            std::fprintf(stderr, "[sampler]   %5.1f%%", 100.0 * s->count / static_cast<double>(t.samples));
+            out("[sampler]   %5.1f%%", 100.0 * s->count / static_cast<double>(t.samples));
             for (std::uintptr_t f : s->frames)
-                if (f) std::fprintf(stderr, " %#lx", static_cast<unsigned long>(f));
-            std::fputc('\n', stderr);
-            if (++shown == 40) break;
+                if (f) out(" %#lx", static_cast<unsigned long>(f));
+            out("\n");
+            if (++shown == 300) break;
         }
     }
+    std::fwrite(g_out.data(), 1, g_out.size(), stderr);
+    std::fflush(stderr);
+    g_out.clear();
 }
 
 }  // namespace
diff --git a/host/switch_threads.cpp b/host/switch_threads.cpp
index 9471ab0..36d0f97 100644
--- a/host/switch_threads.cpp
+++ b/host/switch_threads.cpp
@@ -13,6 +13,7 @@ void switch_sampler_add_thread(Handle handle, std::uintptr_t entry);
 
 namespace {
 std::atomic<int> g_new_thread_core{-1};
+std::atomic<Handle> g_last_placed{INVALID_HANDLE};  // the last thread started on a chosen core
 }
 
 void switch_pin_current_thread(int core) {
@@ -30,7 +31,10 @@ extern "C" Result __wrap_threadCreate(Thread *t, ThreadFunc entry, void *arg, vo
     const int core = g_new_thread_core.load();
     const Result rc = __real_threadCreate(t, entry, arg, stack_mem, stack_sz, prio, core >= 0 ? core : cpuid);
     if (R_SUCCEEDED(rc)) {
-        if (core >= 0) svcSetThreadCoreMask(t->handle, core, 1u << core);
+        if (core >= 0) {
+            svcSetThreadCoreMask(t->handle, core, 1u << core);
+            g_last_placed.store(t->handle);
+        }
         switch_sampler_add_thread(t->handle, reinterpret_cast<std::uintptr_t>(entry));
     }
     return rc;
@@ -38,4 +42,12 @@ extern "C" Result __wrap_threadCreate(Thread *t, ThreadFunc entry, void *arg, vo
 
 // For code outside the runner (a port's GS) that cannot include this header.
 extern "C" void ps2_switch_new_thread_core(int core) { switch_new_thread_core(core); }
+
+// Moves the last thread started on a chosen core to another one: lets a port
+// compare cores for a thread it does not own (Mesa's glthread worker) within
+// one run. Returns false when there is no such thread.
+extern "C" bool ps2_switch_move_placed_thread(int core) {
+    const Handle h = g_last_placed.load();
+    return h != INVALID_HANDLE && R_SUCCEEDED(svcSetThreadCoreMask(h, core, 1u << core));
+}
 #endif
